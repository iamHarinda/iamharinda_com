---
import site from "../data/site.js";
import FiverrLogo from "./FiverrLogo.astro";
import { featured, reviewDate, stars } from "../data/reviews.js";
const { limit = 3, heading = "What photographers say.", link = true } = Astro.props;
const items = featured(limit);
---
<section class="sec dark">
  <div class="wrap">
    <div class="head head--row">
      <div>
        <span class="eyebrow">Reviews</span>
        <h2 class="h2">{heading}</h2>
      </div>
      <div class="score">
        <FiverrLogo height={30} label="Fiverr" />
        <div><b>{site.fiverrStats.reviews}+</b><br /><span class="muted small">reviews on Fiverr</span></div>
      </div>
    </div>
    <div class="grid g3" data-rise>
      {items.map((r) => (
        <blockquote class="rv">
          <p class="rv__meta"><span class="rv__stars" aria-hidden="true">{stars(r.rating)}</span><span class="sr-only">{r.rating} out of 5</span> {reviewDate(r.date)}</p>
          <q>{r.text}</q>
          <footer><b>{r.name}</b><span><span aria-hidden="true">{r.flag}</span> {r.country}</span></footer>
        </blockquote>
      ))}
    </div>
    {link && <p style="margin-top:1.75rem"><a class="link" href="/reviews/" style="color:#F7B08E">Read all {site.fiverrStats.reviews}+ reviews</a></p>}
  </div>
</section>
