const icon = icons[name];
if (!icon) throw new Error(`BrandIcon: unknown name "${name}"`);
const viewBox = icon.vb ?? "0 0 24 24";
const [, , vbW, vbH] = viewBox.split(" ").map(Number);
const width = Math.round(size * (vbW / vbH) * 100) / 100;
---
<svg
  class:list={["brand-icon", cls]}
  viewBox={viewBox}
  width={width}
  height={size}
  xmlns="http://www.w3.org/2000/svg"
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
><path fill={color ?? icon.hex} d={icon.d} /></svg>
<style>
  .brand-icon { display: inline-block; flex: none; vertical-align: middle; }
</style>
