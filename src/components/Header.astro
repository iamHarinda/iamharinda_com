---
import Logo from "./Logo.astro";
import site from "../data/site.js";

const { path = "/" } = Astro.props;
const isCurrent = (href) => href === path || (href !== "/" && path.startsWith(href));
---

<nav class="nav" aria-label="Primary">
  <a class="nav__brand" href="/" aria-label="Harinda Fernando — home"><Logo variant="sig" /></a>
  <ul class="nav__links">
    {site.nav.map((item) => (
      <li><a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{item.label}</a></li>
    ))}
  </ul>
  <a class="btn btn--p btn--sm nav__cta" href="/free-sample/">Get 3 free edits</a>
  <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-sheet" id="nav-toggle">Menu</button>
</nav>
<div class="nav__sheet" id="nav-sheet" data-open="false">
  {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
  <a href="/contact/">Contact</a>
  <a class="btn btn--p" href="/free-sample/">Get 3 photos edited free</a>
</div>
