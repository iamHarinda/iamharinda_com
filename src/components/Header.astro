---
import site from "../data/site.js";

const { path = "/" } = Astro.props;
const isCurrent = (href) =>
  href === path || (href !== "/" && path.startsWith(href));
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="wordmark" href="/">iamharinda</a>

    <nav class="site-nav" aria-label="Primary" data-open="false">
      <button
        type="button"
        class="site-nav__toggle"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span class="site-nav__toggle-label">Menu</span>
      </button>

      <ul class="site-nav__panel" id="primary-nav">
        {
          site.nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  {/* With JavaScript disabled the toggle can't work, so just show the links. */}
  <noscript>
    <style>
      @media (max-width: 44rem) {
        .site-nav__toggle { display: none !important; }
        .site-nav__panel,
        .site-nav[data-open="false"] .site-nav__panel {
          position: static !important;
          display: flex !important;
          flex-direction: row;
          flex-wrap: wrap;
          gap: 0.25rem 1rem !important;
          min-width: 0 !important;
          padding: 0 !important;
          border: 0 !important;
          background: transparent !important;
          box-shadow: none !important;
        }
      }
    </style>
  </noscript>
</header>

<script>
  // Progressive enhancement for the mobile menu. No framework — this is the
  // whole thing. The markup above is fully usable without it.
  for (const nav of document.querySelectorAll<HTMLElement>(".site-nav")) {
    const btn = nav.querySelector<HTMLButtonElement>(".site-nav__toggle");
    const label = nav.querySelector<HTMLElement>(".site-nav__toggle-label");
    if (!btn) continue;

    const set = (open: boolean) => {
      nav.dataset.open = String(open);
      btn.setAttribute("aria-expanded", String(open));
      if (label) label.textContent = open ? "Close" : "Menu";
    };

    btn.addEventListener("click", () => set(nav.dataset.open !== "true"));

    for (const link of nav.querySelectorAll(".site-nav__panel a")) {
      link.addEventListener("click", () => set(false));
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && nav.dataset.open === "true") {
        set(false);
        btn.focus();
      }
    });

    document.addEventListener("pointerdown", (e) => {
      if (
        nav.dataset.open === "true" &&
        e.target instanceof Node &&
        !nav.contains(e.target)
      ) {
        set(false);
      }
    });
  }
</script>
