---
import site, { waLink } from "../data/site.js";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div>
        <p class="footer__brand">iamharinda</p>
        <p style="margin-top:.5rem;max-width:32ch">
          Photo editing, custom web development, and apparel patterns and tech
          packs. One person, working with clients in the United States, Canada
          and Europe.
        </p>
      </div>

      <div>
        <h2>Get in touch</h2>
        <ul>
          <li><a href={waLink("Hi Harinda, I found your site and I'd like to get in touch.")}>WhatsApp</a></li>
          <li><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
          <li><a href={site.contact.fiverr} rel="me noopener" target="_blank">Fiverr profile</a></li>
        </ul>
      </div>

      <div>
        <h2>Services</h2>
        <ul>
          <li><a href="/wedding-photo-editing/">Wedding photo editing</a></li>
          <li><a href="/custom-web-development/">Custom web development</a></li>
          <li><a href="/apparel-pattern-tech-packs/">Apparel patterns &amp; tech packs</a></li>
          <li><a href="/pricing/">Photo editing pricing</a></li>
        </ul>
      </div>

      <div>
        <h2>Pages</h2>
        <ul>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </div>

      <div>
        <h2>Areas served</h2>
        <ul>
          {site.areasServed.map((a) => <li>{a}</li>)}
        </ul>
      </div>
    </div>

    <div class="footer__legal">
      <span>&copy; {year} iamharinda.</span>
      <span><a href="/llms.txt">llms.txt</a></span>
    </div>
  </div>
</footer>
