---
// Before/after comparison: the edit sits on top of the original and is revealed from the left.
// Drag the handle, click anywhere, or use the keyboard (it is a real range input).
// Usage: <BeforeAfter before={img} after={img} alt="…" /> with Cloudinary images { id, v, w, h }.
import { cld, cldSrcset } from "../data/portfolio.js";
const { before, after, alt, ar = "4:5", sizes = "(min-width: 861px) 45vw, 100vw", start = 50 } = Astro.props;
const widths = [640, 960, 1280, 1600];
const [aw, ah] = ar.split(":").map(Number);
---
<div class="ba" style={`--pos:${start}%; aspect-ratio:${aw} / ${ah}`} data-ba>
  <img class="ba__img" src={cld(before, { w: 1280, ar })} srcset={cldSrcset(before, widths, { ar })} sizes={sizes} width="1280" height={Math.round((1280 * ah) / aw)} alt={`Before: ${alt}`} loading="lazy" decoding="async" />
  <img class="ba__img ba__after" src={cld(after, { w: 1280, ar })} srcset={cldSrcset(after, widths, { ar })} sizes={sizes} width="1280" height={Math.round((1280 * ah) / aw)} alt={`After: ${alt}`} loading="lazy" decoding="async" />
  <span class="ba__tag ba__tag--before" aria-hidden="true">Before</span>
  <span class="ba__tag ba__tag--after" aria-hidden="true">After</span>
  <span class="ba__line" aria-hidden="true"><span class="ba__knob"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6-6 6 6 6M15 6l6 6-6 6" /></svg></span></span>
  <input class="ba__range" type="range" min="0" max="100" value={start} aria-label="Drag to compare before and after" />
</div>

<style>
  .ba { position: relative; overflow: hidden; border-radius: var(--r-lg); box-shadow: var(--shadow-2); background: var(--panel); user-select: none; touch-action: pan-y; }
  .ba__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .ba__after { clip-path: inset(0 0 0 var(--pos)); }
  .ba__line { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 2px; margin-left: -1px; background: #fff; box-shadow: 0 0 12px rgb(0 0 0 / .35); pointer-events: none; }
  .ba__knob { position: absolute; top: 50%; left: 50%; display: grid; place-items: center; width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 50%; background: #fff; color: #17171A; box-shadow: 0 6px 18px rgb(0 0 0 / .3); }
  .ba__tag { position: absolute; top: 14px; padding: .3rem .7rem; border-radius: 999px; background: rgb(14 14 16 / .6); color: #fff; font: 500 .72rem/1 var(--f-mono); letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(6px); pointer-events: none; }
  .ba__tag--before { left: 14px; }
  .ba__tag--after { right: 14px; }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; }
  .ba:has(.ba__range:focus-visible) .ba__knob { outline: 3px solid var(--accent); outline-offset: 2px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-ba]").forEach((el) => {
    const range = el.querySelector<HTMLInputElement>(".ba__range");
    range?.addEventListener("input", () => el.style.setProperty("--pos", `${range.value}%`));
  });
</script>
