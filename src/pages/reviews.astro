---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Bits from "../components/Bits.astro";
import WorldMap from "../components/WorldMap.astro";
import Cta from "../components/Cta.astro";
import site from "../data/site.js";
import { reviews, reviewDate, stars } from "../data/reviews.js";
import { breadcrumb } from "../lib/schema.js";

const crumbs = [{ name: "Home", path: "/" }, { name: "Reviews", path: "/reviews/" }];
const SHOWN = 24;

// Breakdown for the summary bar: exact 5★, then each whole-star band below it
// (4–4.9★ etc.), so a 4.7 is never counted as a five.
const buckets = [
  { label: "5★", n: reviews.filter((r) => r.rating === 5).length },
  ...[4, 3, 2, 1].map((s) => ({ label: `${s}★`, n: reviews.filter((r) => r.rating >= s && r.rating < s + 1).length })),
]
  .filter((b) => b.n > 0)
  .map((b) => ({ ...b, pct: Math.round((b.n / reviews.length) * 100) }));
---
<BaseLayout rawTitle={`Photo Editing Reviews — ${site.fiverrStats.rating} Stars from ${site.fiverrStats.reviews}+ Clients`} description={`What photographers say about Harinda Fernando's photo editing: ${site.fiverrStats.rating} stars from ${site.fiverrStats.reviews}+ Fiverr reviews and ${site.fiverrStats.ordersPlus}+ orders.`} path="/reviews/" jsonLd={[breadcrumb(crumbs)]}>
  <PageHero eyebrow="Reviews" title={`${site.fiverrStats.rating} stars from ${site.fiverrStats.reviews}+ Fiverr reviews`} lede="Every review below is real feedback from a completed Fiverr order, word for word. Client names are masked for privacy." crumbs={crumbs}>
    <p style="margin-top:.5rem"><a class="link" href={site.contact.fiverr} target="_blank" rel="noopener" data-track="fiverr">See the profile on Fiverr</a></p>
  </PageHero>
  <section class="sec sec--top0"><div class="wrap"><Bits kind="stats" /></div></section>

  <section class="sec dark" id="all-reviews">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <span class="eyebrow">In their words</span>
          <h2 class="h2">{reviews.length} reviews, earned order by order.</h2>
        </div>
        <ul class="rv-bars" aria-label="Ratings breakdown">
          {buckets.map((b) => (
            <li><span>{b.label}</span><i style={`--w:${b.pct}%`}></i><span>{b.n}</span></li>
          ))}
        </ul>
      </div>
      <div class="grid g3 rv-list" data-more>
        {reviews.map((r) => (
          <blockquote class="rv">
            <p class="rv__meta"><span class="rv__stars" aria-hidden="true">{stars(r.rating)}</span><span class="sr-only">{r.rating} out of 5</span> {reviewDate(r.date)}</p>
            <q>{r.text}</q>
            <footer><b>{r.name}</b><span><span aria-hidden="true">{r.flag}</span> {r.country}</span></footer>
          </blockquote>
        ))}
      </div>
      {reviews.length > SHOWN && (
        <div class="rv-more">
          <button class="btn btn--s btn--light" type="button" data-more-btn>Show all {reviews.length} reviews</button>
          <p class="small muted">Showing {SHOWN} of {reviews.length}</p>
        </div>
      )}
    </div>
  </section>

  <WorldMap />
  <Cta />
</BaseLayout>

<style>
  .rv-bars { list-style: none; margin: 0; padding: 0; display: grid; gap: .35rem; min-width: 14rem; font-size: var(--t-sm); color: #A6A5A0; }
  .rv-bars li { display: grid; grid-template-columns: 2rem 1fr 2.2rem; align-items: center; gap: .6rem; margin: 0; }
  .rv-bars i { display: block; height: 6px; border-radius: 999px; background: #33333A; position: relative; overflow: hidden; }
  .rv-bars i::after { content: ""; position: absolute; inset: 0 auto 0 0; width: var(--w); background: #F7B08E; border-radius: inherit; }
  .rv-bars li span:last-child { text-align: right; }
  .rv-more { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2rem; }
</style>

<script>
  const list = document.querySelector(".rv-list[data-more]");
  const btn = document.querySelector("[data-more-btn]");
  btn?.addEventListener("click", () => {
    list?.removeAttribute("data-more");
    btn.closest(".rv-more")?.remove();
    window.dispatchEvent(new Event("resize")); // let scroll animations re-measure
  });
</script>
