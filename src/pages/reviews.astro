---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Bits from "../components/Bits.astro";
import WorldMap from "../components/WorldMap.astro";
import Cta from "../components/Cta.astro";
import FiverrLogo from "../components/FiverrLogo.astro";
import site from "../data/site.js";
import { bestFirst, reviewDate, stars } from "../data/reviews.js";
import { breadcrumb } from "../lib/schema.js";

const crumbs = [{ name: "Home", path: "/" }, { name: "Reviews", path: "/reviews/" }];
// The 50 most detailed 5★ reviews (one per client) come first; "Show all" reveals the rest.
const SHOWN = 50;
const reviews = bestFirst(SHOWN);
---
<BaseLayout rawTitle={`Photo Editing Reviews — ${site.fiverrStats.reviews}+ Fiverr Reviews from Real Clients`} description={`What photographers say about Harinda Fernando's photo editing: ${site.fiverrStats.reviews}+ Fiverr reviews and ${site.fiverrStats.ordersPlus}+ orders.`} path="/reviews/" jsonLd={[breadcrumb(crumbs)]}>
  <PageHero eyebrow="Reviews" title={`${site.fiverrStats.reviews}+ reviews from real clients`} lede="Every review below is real feedback from a completed Fiverr order, word for word. Client names are masked for privacy." crumbs={crumbs}>
    <p style="margin-top:.5rem"><a class="link" href={site.contact.fiverr} target="_blank" rel="noopener" data-track="fiverr">See the profile on <FiverrLogo height={15} label="Fiverr" /></a></p>
  </PageHero>
  <section class="sec sec--top0"><div class="wrap"><Bits kind="stats" /></div></section>

  <section class="sec dark" id="all-reviews">
    <div class="wrap">
      <div class="head head--row">
        <div>
          <span class="eyebrow">In their words</span>
          <h2 class="h2">{reviews.length} reviews, word for word.</h2>
          <p class="muted" style="margin-top:.75rem;max-width:40em">The {SHOWN} most detailed come first, one per client. Every review is copied exactly as the client wrote it on Fiverr.</p>
        </div>
        <a class="btn btn--s btn--light" href={site.contact.fiverr} target="_blank" rel="noopener" data-track="fiverr">All reviews on <FiverrLogo height={14} label="Fiverr" /></a>
      </div>
      <div class="grid g3 rv-list" data-more>
        {reviews.map((r) => (
          <blockquote class="rv">
            <p class="rv__meta"><span class="rv__stars" aria-hidden="true">{stars(r.rating)}</span><span class="sr-only">{r.rating} out of 5</span> {reviewDate(r.date)}</p>
            <q>{r.text}</q>
            <footer><b>{r.name}</b><span><span aria-hidden="true">{r.flag}</span> {r.country}</span></footer>
          </blockquote>
        ))}
      </div>
      {reviews.length > SHOWN && (
        <div class="rv-more">
          <button class="btn btn--s btn--light" type="button" data-more-btn>Show all {reviews.length} reviews</button>
          <p class="small muted">Showing {SHOWN} of {reviews.length}</p>
        </div>
      )}
    </div>
  </section>

  <WorldMap />
  <Cta />
</BaseLayout>

<style>
  .rv-more { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2rem; }
</style>

<script>
  const list = document.querySelector(".rv-list[data-more]");
  const btn = document.querySelector("[data-more-btn]");
  btn?.addEventListener("click", () => {
    list?.removeAttribute("data-more");
    btn.closest(".rv-more")?.remove();
    window.dispatchEvent(new Event("resize")); // let scroll animations re-measure
  });
</script>
