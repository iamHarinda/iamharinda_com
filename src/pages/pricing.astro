---
import BaseLayout from "../layouts/BaseLayout.astro";
import site, { waLink, priceRange } from "../data/site.js";
import {
  professionalService,
  offerCatalogDocument,
  faqPage,
  breadcrumb,
} from "../lib/schema.js";

const pricingFaqs = site.faqs.filter((f) =>
  [
    "Do you offer a free sample edit?",
    "What does photo editing cost?",
    "When do I pay?",
    "How many revisions do I get?",
  ].includes(f.q)
);

const jsonLd = [
  professionalService(),
  offerCatalogDocument(),
  faqPage(pricingFaqs),
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Pricing", path: "/pricing/" },
  ]),
];
---

<BaseLayout
  title="Pricing | iamharinda"
  description={`What each service costs: photo editing from $10, web development from $750, fashion designing from $10. All prices in USD.`}
  path="/pricing/"
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pricing</span>
        <h1 class="h1"><span class="split">What everything costs.</span></h1>
        <p>
          Four services, each priced its own way. Here is the summary — follow a
          card for the full breakdown. Every service is quoted or invoiced in US
          dollars.
        </p>
      </div>

      <div class="price-grid">
        {
          site.pricingSummary.map((s) => (
            <a class="card price-card rise" href={s.href} data-spot>
              <div class="price-card__photos">{s.label}</div>
              <div class="price-card__amount grad-text">from {s.from}</div>
              <div class="price-card__unit">{s.unit}</div>
              <p style="margin-top:1rem">{s.line}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Photo editing — full breakdown ──────────────────────────────── -->
  <section class="section" id="photo-editing">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Photo editing</span>
        <h2 class="h2 reveal"><span class="split">Flat rates. Paid after delivery.</span></h2>
        <p>Priced by the number of photos. No subscription, no deposit, no per-revision fee.</p>
      </div>

      <div class="price-grid">
        {
          site.packages.map((p, i) => (
            <article class={`card price-card rise${i === 1 ? " price-card--featured beam" : ""}`} data-spot>
              <div class="price-card__photos">{p.photos} photos</div>
              <div class="price-card__amount grad-text">${p.price}</div>
              <div class="price-card__unit">
                ${(p.price / p.photos).toFixed(2)} per photo · {site.currency}
              </div>
            </article>
          ))
        }
      </div>

      <p class="bulk-note rise">{site.bulkNote}</p>

      <div class="callout beam rise" style="margin-top:2.5rem">
        <div>
          <h2 class="grad-text">{site.freeSample.short}</h2>
          <p>{site.freeSample.line} The best way to check the quality before you order.</p>
        </div>
        <a class="btn" data-magnetic href={waLink("Hi Harinda, could you do a free sample edit of a few of my photos?")}>{site.freeSample.cta}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Every photo order includes</span>
        <h2 class="h2 reveal">What is always in the price.</h2>
      </div>
      <ul class="list-check rise">
        {site.includes.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Payment methods</span>
        <h2 class="h2 reveal">However works for you.</h2>
        <p>Photo work is invoiced once the edited photos are delivered and approved. Web and fashion design projects are staged — see each service page.</p>
      </div>
      <div class="tools-grid">
        {
          site.paymentLogos.map((p) => (
            <div class="tool-card rise" data-spot>
              <span class="tool-card__logo">
                <img src={p.logo} alt={p.name} width="40" height="40" loading="lazy" decoding="async" />
              </span>
              <span class="tool-card__name">{p.name}</span>
            </div>
          ))
        }
      </div>
      <ul class="pay-list rise" style="margin-top:2rem">
        {site.payments.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Ordering photo editing</span>
        <h2 class="h2 reveal">How to place an order.</h2>
      </div>
      <ol class="list-check rise">
        {site.ordering.map((item) => <li>{item}</li>)}
      </ol>
      <div class="btn-row" style="margin-top:2rem">
        <a class="btn" data-magnetic href={waLink("Hi Harinda, I'd like to order photo editing. Here are the details:")}>Order on WhatsApp</a>
        <a class="btn btn--grad" href={site.contact.fiverr} target="_blank" rel="noopener">Book on Fiverr</a>
      </div>
    </div>
  </section>
</BaseLayout>
