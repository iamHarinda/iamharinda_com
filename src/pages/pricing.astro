---
import BaseLayout from "../layouts/BaseLayout.astro";
import FiverrLogo from "../components/FiverrLogo.astro";
import PageHero from "../components/PageHero.astro";
import Pricing from "../components/Pricing.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import site from "../data/site.js";
import { service, faqPage, breadcrumb } from "../lib/schema.js";

const crumbs = [{ name: "Home", path: "/" }, { name: "Pricing", path: "/pricing/" }];
const faqs = site.faqs.filter((f) => /cost|pay|revisions|free/i.test(f.q));
const payments = ["PayPal invoice (card, Venmo, Apple Pay, Google Pay)", "PayPal transfer", "Payoneer", "Remitly", "TapSend", "Bank transfer"];
const jsonLd = [service({ name: "Photo editing", path: "/pricing/", description: "Photo editing packages from $10 per 50 photos." }), faqPage(faqs), breadcrumb(crumbs)];
---
<BaseLayout rawTitle="Photo Editing Prices per Image, Web & Design Rates" description="Photo editing from $0.20 per image, no deposit, pay after approval. Custom websites from $750, polo shirt design from $10. All prices in USD." path="/pricing/" jsonLd={jsonLd}>
  <PageHero eyebrow="Pricing" title="Prices for photo editing, web development and polo design" lede="Flat, published prices in US dollars. Photo editing is paid after you approve the gallery when you order direct." crumbs={crumbs} />

  <section class="sec sec--top0" id="photo-editing">
    <div class="wrap">
      <div class="head"><h2 class="h2">Photo editing · {site.perPhoto} a photo</h2><p class="lede">Weddings, portraits, events, product and food. {site.freeSample.short} before you order.</p></div>
      <Pricing />
      <ul class="checks" style="margin-top:1.75rem">{site.includes.map((i) => <li>{i}</li>)}</ul>
    </div>
  </section>

  <section class="sec sec--alt">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Two ways to order</span><h2 class="h2">Order direct or on Fiverr</h2></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th scope="col"></th>{site.orderWays.map((o) => <th scope="col">{o.label}</th>)}</tr></thead>
          <tbody>
            <tr><th scope="row">Price</th>{site.orderWays.map((o) => <td>{o.price}</td>)}</tr>
            <tr><th scope="row">When you pay</th>{site.orderWays.map((o) => <td>{o.pay}</td>)}</tr>
            <tr><th scope="row">Protection</th>{site.orderWays.map((o) => <td>{o.protection}</td>)}</tr>
            <tr><th scope="row">Best for</th>{site.orderWays.map((o) => <td>{o.best}</td>)}</tr>
          </tbody>
        </table>
      </div>
      <div class="btn-row" style="margin-top:1.25rem">
        <a class="btn btn--p" href="/free-sample/">Start with a free sample</a>
        <a class="btn btn--s" href={site.contact.fiverr} target="_blank" rel="noopener" data-track="fiverr">Order on <FiverrLogo height={15} label="Fiverr" /></a>
      </div>
      <p class="price-note">Payment methods for direct orders: {payments.join(" · ")}.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap grid g2">
      <a class="card card--link" href="/web-development/#pricing"><span class="eyebrow">Web development</span><h3 style="font:500 2.4rem/1 var(--f-display);margin:.5rem 0">From $750</h3><p>Fixed price after a free scope call. Hand-coded, no WordPress, and you keep the code. Optional upkeep $150/month.</p><span class="link" style="margin-top:auto">See web development prices</span></a>
      <a class="card card--link" href="/fashion-designing/#pricing"><span class="eyebrow">Polo &amp; golf shirt design</span><h3 style="font:500 2.4rem/1 var(--f-display);margin:.5rem 0">From $10</h3><p>Print-ready designs with front and back mockups. $10 for 1 design, $25 for 3, $40 for 5. Unlimited revisions.</p><span class="link" style="margin-top:auto">See polo design packages</span></a>
    </div>
  </section>

  <section class="sec sec--alt">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Questions</span><h2 class="h2">Pricing FAQ</h2></div>
      <Faq items={faqs} />
    </div>
  </section>
  <Cta />
</BaseLayout>
