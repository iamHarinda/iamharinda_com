---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FiverrLogo from "../../components/FiverrLogo.astro";
import PageHero from "../../components/PageHero.astro";
import site, { waLink } from "../../data/site.js";
import { breadcrumb } from "../../lib/schema.js";

const crumbs = [{ name: "Home", path: "/" }, { name: "Contact", path: "/contact/" }];
---
<BaseLayout rawTitle="Contact Harinda — Free Sample Edit or Quote" description="Ask for a free sample edit or a fixed-price quote for photo editing, web development or polo shirt design. WhatsApp, email or the contact form." path="/contact/" jsonLd={[breadcrumb(crumbs)]}>
  {site.turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>}
  <PageHero eyebrow="Contact" title="Contact &amp; quotes" lede={`Photo editing, a website or a polo design: say what you need and get a reply ${site.replyTime}. For photo editing, the free sample form is the fastest start.`} crumbs={crumbs}>
    <p style="margin-top:.25rem"><a class="link" href="/free-sample/">Request a free sample edit instead</a></p>
  </PageHero>
  <section class="sec sec--top0">
    <div class="wrap grid g-form">
      <div class="card">
        <p class="alert alert--err" id="form-error" hidden>That didn't go through. Please email {site.contact.email} or message on WhatsApp instead.</p>
        <form class="form" method="POST" action="/contact.php" data-lead="contact">
          <input type="hidden" name="form" value="contact" />
          <div class="row2">
            <div class="field"><label for="c-name">Your name</label><input id="c-name" name="name" autocomplete="name" required /></div>
            <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" autocomplete="email" required /></div>
          </div>
          <div class="field">
            <label for="c-service">Which service?</label>
            <select id="c-service" name="service">{site.contact.services.map((s) => <option>{s}</option>)}</select>
          </div>
          <div class="field">
            <label for="c-msg">What do you need?</label>
            <textarea id="c-msg" name="message" rows="6" required aria-describedby="c-msg-hint"></textarea>
            <span class="hint" id="c-msg-hint">Photo work: shoot type, number of photos, deadline. Website or design: what you're building and when you need it.</span>
          </div>
          <div class="hp" aria-hidden="true"><label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
          {site.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey}></div>}
          <button class="btn btn--p" type="submit">Send message</button>
        </form>
      </div>
      <aside class="stack">
        <div class="card"><h2 style="font:600 1.05rem/1.3 var(--f-body)">WhatsApp</h2><p><a class="link" href={waLink("Hi Harinda, I found your site and I'd like to talk about a project.")} data-track="whatsapp">{site.contact.whatsappDisplay}</a></p><p>For photo editing orders. The fastest way to reach me.</p></div>
        <div class="card"><h2 style="font:600 1.05rem/1.3 var(--f-body)">Phone in Sri Lanka</h2><p><a class="link" href={`tel:${site.contact.phoneLk}`} data-track="phone">{site.contact.phoneLkDisplay}</a></p><p>My personal number, for people in Sri Lanka.</p></div>
        <div class="card"><h2 style="font:600 1.05rem/1.3 var(--f-body)">Email</h2><p><a class="link" href={`mailto:${site.contact.email}`} data-track="email">{site.contact.email}</a></p></div>
        <div class="card"><h2 style="font:600 1.05rem/1.3 var(--f-body)"><FiverrLogo height={20} label="Fiverr" /></h2><p><a class="link" href={site.contact.fiverr} target="_blank" rel="noopener" data-track="fiverr">fiverr.com/{site.handle}</a></p><p>Order with Fiverr buyer protection.</p></div>
        <div class="card card--soft"><p>{site.location.note}</p></div>
      </aside>
    </div>
  </section>
  <script is:inline>if (location.search.includes("error=1")) document.getElementById("form-error").hidden = false;</script>
</BaseLayout>
