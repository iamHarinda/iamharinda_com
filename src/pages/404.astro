---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---
<BaseLayout title="Page not found" description="That page doesn't exist." path="/404.html" noindex>
  <PageHero eyebrow="404" title="That page isn't here." lede="It may have moved when the site was redesigned. These are the pages people usually look for.">
    <div class="chips" style="margin-top:.75rem">
      <a class="pill" href="/photo-editing/" style="text-decoration:none">Photo editing</a>
      <a class="pill" href="/photo-editing/wedding/" style="text-decoration:none">Wedding editing</a>
      <a class="pill" href="/work/" style="text-decoration:none">Work</a>
      <a class="pill" href="/pricing/" style="text-decoration:none">Pricing</a>
      <a class="pill" href="/blog/" style="text-decoration:none">Blog</a>
    </div>
    <div class="btn-row" style="margin-top:1.25rem"><a class="btn btn--p" href="/">Go to the home page</a><a class="btn btn--s" href="/free-sample/">Get 3 free edits</a></div>
  </PageHero>
</BaseLayout>
