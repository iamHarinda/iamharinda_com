---
import BaseLayout from "../layouts/BaseLayout.astro";
import site, { waLink } from "../data/site.js";
import { professionalService } from "../lib/schema.js";
---

<BaseLayout
  title="Page not found"
  description="That page does not exist."
  path="/404.html"
  noindex
  chrome={false}
  jsonLd={[professionalService()]}
>
  <div class="container notfound notfound--space">
    <!-- Decorative scene: a big dim "404" sits behind everything, a small
         space dock blinks its lights, and an astronaut hops/drifts across in
         search of the page. Pure CSS, no images. -->
    <p class="space-404" aria-hidden="true">404</p>

    <svg class="space-dock" viewBox="0 0 160 90" aria-hidden="true" focusable="false">
      <ellipse class="dock__hull-shade" cx="80" cy="60" rx="58" ry="13" />
      <ellipse class="dock__hull" cx="80" cy="50" rx="68" ry="24" />
      <rect class="dock__antenna-stem" x="75" y="14" width="6" height="20" rx="3" />
      <circle class="dock__antenna-tip" cx="78" cy="12" r="5" />
      <circle class="dock__window-glow" cx="100" cy="48" r="17" />
      <circle class="dock__window" cx="100" cy="48" r="9" />
      <circle class="dock__light dock__light--1" cx="33" cy="62" r="4" />
      <circle class="dock__light dock__light--2" cx="57" cy="68" r="4" />
      <circle class="dock__light dock__light--3" cx="81" cy="62" r="4" />
    </svg>

    <svg class="astronaut" viewBox="0 0 120 170" aria-hidden="true" focusable="false">
      <g class="astronaut__body">
        <rect class="astronaut__pack" x="18" y="80" width="16" height="30" rx="6" />
        <rect class="astronaut__pack" x="86" y="80" width="16" height="30" rx="6" />
        <rect class="astronaut__leg" x="42" y="132" width="16" height="30" rx="8" />
        <rect class="astronaut__leg" x="62" y="132" width="16" height="30" rx="8" />
        <ellipse class="astronaut__boot" cx="50" cy="163" rx="12" ry="7" />
        <ellipse class="astronaut__boot" cx="70" cy="163" rx="12" ry="7" />
        <rect class="astronaut__arm" x="14" y="84" width="16" height="40" rx="8" transform="rotate(18 22 84)" />
        <rect class="astronaut__arm" x="90" y="84" width="16" height="40" rx="8" transform="rotate(-18 98 84)" />
        <rect class="astronaut__torso" x="30" y="70" width="60" height="70" rx="30" />
        <circle class="astronaut__panel" cx="60" cy="100" r="10" />
        <circle class="astronaut__dot astronaut__dot--a" cx="56" cy="98" r="2.4" />
        <circle class="astronaut__dot astronaut__dot--b" cx="64" cy="98" r="2.4" />
        <circle class="astronaut__dot astronaut__dot--c" cx="60" cy="104" r="2.4" />
        <rect class="astronaut__antenna-stem" x="58" y="0" width="4" height="12" rx="2" />
        <circle class="astronaut__antenna-tip" cx="60" cy="0" r="4" />
        <circle class="astronaut__helmet" cx="60" cy="44" r="38" />
        <circle class="astronaut__visor" cx="60" cy="46" r="27" />
        <circle class="astronaut__visor-shade" cx="69" cy="53" r="19" />
        <ellipse class="astronaut__shine" cx="49" cy="35" rx="8" ry="5" />
      </g>
    </svg>

    <div class="notfound__foreground">
      <h1 class="sr-only">404 — page not found</h1>
      <p class="notfound__lede">Page not found. It may have moved.</p>

      <div class="btn-row" style="justify-content:center;margin-top:1rem">
        <a class="btn" data-magnetic href={waLink("Hi Harinda, I hit a broken link on your site:")}>Message on WhatsApp</a>
        <a class="btn btn--grad" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </div>
      <p style="margin-top:1.5rem">
        <a class="text-link" href="/">Go to the home page</a>
      </p>
    </div>
  </div>
</BaseLayout>
