---
import BaseLayout from "../layouts/BaseLayout.astro";
import { professionalService } from "../lib/schema.js";
---

<BaseLayout
  title="Page not found"
  description="That page does not exist."
  path="/404.html"
  noindex
  jsonLd={[professionalService()]}
>
  <div class="container notfound">
    <p class="eyebrow" style="justify-content:center">Error 404</p>
    <h1 class="grad-text">Page not found</h1>
    <p>The page you were after isn&rsquo;t here. It may have moved.</p>
    <div class="btn-row" style="justify-content:center;margin-top:.5rem">
      <a class="btn" data-magnetic href="/">Go to the home page</a>
      <a class="btn btn--grad" href="/pricing/">See pricing</a>
    </div>
  </div>
</BaseLayout>
