---
import { readFileSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import site, { waLink } from "../data/site.js";
import { professionalService } from "../lib/schema.js";

// Astronaut and rocket artwork — unDraw illustrations (MIT licence), cropped
// from their source scenes and recoloured to theme tokens. See the comment
// at the top of each file for provenance. Read at build time and inlined so
// they inherit the page's CSS custom properties (fill="var(--c-teal)" etc.
// only resolves when the SVG lives in the same document as the tokens).
const astronautSvg = readFileSync(
  new URL("../assets/404/astronaut-inner.svg", import.meta.url),
  "utf-8"
);
const rocketSvg = readFileSync(
  new URL("../assets/404/rocket-inner.svg", import.meta.url),
  "utf-8"
);

// Two star layers as one big box-shadow each — cheap way to scatter a lot of
// dots without extra DOM nodes. Coordinates are laid out on a 1600×900
// reference canvas; the page is close enough to that ratio that it still
// reads as an even scatter at other sizes.
function stars(count: number, minOpacity: number, maxOpacity: number) {
  const dots: string[] = [];
  for (let i = 0; i < count; i++) {
    const x = Math.round(Math.random() * 1600);
    const y = Math.round(Math.random() * 900);
    const o = (minOpacity + Math.random() * (maxOpacity - minOpacity)).toFixed(2);
    dots.push(`${x}px ${y}px 0 rgb(255 255 255 / ${o})`);
  }
  return dots.join(",");
}
const starsNear = stars(90, 0.5, 0.95);
const starsFar = stars(130, 0.15, 0.45);
---

<BaseLayout
  title="Page not found"
  description="That page does not exist."
  path="/404.html"
  noindex
  chrome={false}
  jsonLd={[professionalService()]}
>
  <div class="container notfound notfound--space">
    <!-- Decorative scene, all CSS/SVG, no images: a starfield, a giant dim
         "404" watermark, a ship sweeping searchlight beams left and right,
         and an astronaut drifting through them in slow motion. -->
    <div class="stars stars--near" style={`box-shadow:${starsNear}`}></div>
    <div class="stars stars--far" style={`box-shadow:${starsFar}`}></div>

    <p class="space-404" aria-hidden="true">404</p>

    <div class="beam-rig" aria-hidden="true">
      <span class="beam beam--a"></span>
      <span class="beam beam--b"></span>
      <span class="beam beam--c"></span>
    </div>

    <svg class="space-ship" viewBox="0 0 220 130" aria-hidden="true" focusable="false">
      <polygon class="ship__fuselage" points="0,55 46,28 172,24 220,50 220,80 172,106 46,102" />
      <polygon class="ship__fin" points="58,24 68,2 78,24" />
      <ellipse class="ship__pod" cx="204" cy="40" rx="15" ry="11" />
      <ellipse class="ship__pod" cx="204" cy="90" rx="15" ry="11" />
      <circle class="ship__thruster" cx="204" cy="40" r="6" />
      <circle class="ship__thruster" cx="204" cy="90" r="6" />
      <circle class="ship__cockpit-glow" cx="58" cy="65" r="20" />
      <circle class="ship__cockpit" cx="58" cy="65" r="12" />
      <rect class="ship__panel ship__panel--a" x="90" y="38" width="20" height="11" rx="3" />
      <rect class="ship__panel ship__panel--b" x="122" y="36" width="20" height="11" rx="3" />
      <rect class="ship__panel ship__panel--c" x="154" y="38" width="20" height="11" rx="3" />
      <rect class="ship__panel ship__panel--a" x="90" y="82" width="20" height="11" rx="3" />
      <rect class="ship__panel ship__panel--c" x="154" y="82" width="20" height="11" rx="3" />
    </svg>

    <svg class="astronaut" viewBox="0 0 120 170" aria-hidden="true" focusable="false">
      <g class="astronaut__body">
        <rect class="astronaut__pack" x="18" y="80" width="16" height="30" rx="6" />
        <rect class="astronaut__pack" x="86" y="80" width="16" height="30" rx="6" />
        <rect class="astronaut__leg" x="36" y="128" width="16" height="34" rx="8" transform="rotate(-10 44 128)" />
        <rect class="astronaut__leg" x="66" y="130" width="16" height="30" rx="8" transform="rotate(16 74 130)" />
        <ellipse class="astronaut__boot" cx="44" cy="163" rx="12" ry="7" />
        <ellipse class="astronaut__boot" cx="76" cy="158" rx="12" ry="7" />
        <rect class="astronaut__arm" x="14" y="60" width="16" height="42" rx="8" transform="rotate(-55 22 60)" />
        <rect class="astronaut__arm" x="90" y="88" width="16" height="36" rx="8" transform="rotate(-10 98 88)" />
        <rect class="astronaut__torso" x="30" y="70" width="60" height="70" rx="30" />
        <circle class="astronaut__panel" cx="60" cy="100" r="10" />
        <circle class="astronaut__dot astronaut__dot--a" cx="56" cy="98" r="2.4" />
        <circle class="astronaut__dot astronaut__dot--b" cx="64" cy="98" r="2.4" />
        <circle class="astronaut__dot astronaut__dot--c" cx="60" cy="104" r="2.4" />
        <circle class="astronaut__helmet" cx="60" cy="44" r="38" />
        <circle class="astronaut__visor" cx="60" cy="46" r="27" />
        <circle class="astronaut__visor-shade" cx="69" cy="53" r="19" />
        <ellipse class="astronaut__shine" cx="49" cy="35" rx="8" ry="5" />
        <rect class="astronaut__antenna-stem" x="58" y="0" width="4" height="12" rx="2" />
        <circle class="astronaut__antenna-tip" cx="60" cy="0" r="4" />
      </g>
    </svg>

    <div class="notfound__foreground">
      <h1 class="h1 grad-text">Lost in space.</h1>
      <p class="notfound__lede">
        This page doesn&rsquo;t exist. It may have moved — here&rsquo;s how to
        reach me instead.
      </p>

      <div class="btn-row" style="justify-content:center;margin-top:1rem">
        <a class="btn" data-magnetic href={waLink("Hi Harinda, I hit a broken link on your site:")}>Message on WhatsApp</a>
        <a class="btn btn--grad" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </div>
      <p style="margin-top:1.5rem">
        <a class="text-link" href="/">Go to the home page</a>
      </p>
    </div>
  </div>
</BaseLayout>
