---
import BaseLayout from "../layouts/BaseLayout.astro";
import site, { waLink } from "../data/site.js";
import { professionalService } from "../lib/schema.js";
---

<BaseLayout
  title="Page not found"
  description="That page does not exist."
  path="/404.html"
  noindex
  chrome={false}
  jsonLd={[professionalService()]}
>
  <div class="container notfound notfound--spotlight">
    <!-- Ceiling-mounted lamp, swinging like a pendulum. The beam and the
         mask on the "404" text below share one animation timing so the lit
         patch of text tracks directly under the lamp as it swings. -->
    <div class="spotlight-rig" aria-hidden="true">
      <span class="spotlight-lamp"></span>
      <span class="spotlight-beam"></span>
    </div>

    <h1 class="spotlight-404">
      <span class="spotlight-404__dim" aria-hidden="true">404</span>
      <span class="spotlight-404__lit">404</span>
    </h1>

    <p class="notfound__lede">Page not found. It may have moved.</p>

    <div class="btn-row" style="justify-content:center;margin-top:1rem">
      <a class="btn" data-magnetic href={waLink("Hi Harinda, I hit a broken link on your site:")}>Message on WhatsApp</a>
      <a class="btn btn--grad" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    </div>
    <p style="margin-top:1.5rem">
      <a class="text-link" href="/">Go to the home page</a>
    </p>
  </div>
</BaseLayout>

<style>
  /* This page swaps the sitewide aurora canvas for a plain dark ground —
     the swinging spotlight is the only light source here. */
  :global(#bg) {
    display: none;
  }
</style>
