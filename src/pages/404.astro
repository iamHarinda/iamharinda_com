---
import BaseLayout from "../layouts/BaseLayout.astro";
import site, { waLink } from "../data/site.js";
import { professionalService } from "../lib/schema.js";
---

<BaseLayout
  title="Page not found"
  description="That page does not exist."
  path="/404.html"
  noindex
  chrome={false}
  jsonLd={[professionalService()]}
>
  <div class="container notfound notfound--space">
    <!-- Decorative scene: a big dim "404" sits behind everything, a small
         space dock blinks its lights, and an astronaut hops/drifts across in
         search of the page. Pure CSS, no images. -->
    <p class="space-404" aria-hidden="true">404</p>

    <div class="space-dock" aria-hidden="true">
      <span class="space-dock__hull"></span>
      <span class="space-dock__window"></span>
      <span class="space-dock__light space-dock__light--1"></span>
      <span class="space-dock__light space-dock__light--2"></span>
      <span class="space-dock__light space-dock__light--3"></span>
    </div>

    <div class="astronaut" aria-hidden="true">
      <div class="astronaut__body">
        <span class="astronaut__backpack"></span>
        <span class="astronaut__torso"></span>
        <span class="astronaut__arm astronaut__arm--l"></span>
        <span class="astronaut__arm astronaut__arm--r"></span>
        <span class="astronaut__leg astronaut__leg--l"></span>
        <span class="astronaut__leg astronaut__leg--r"></span>
        <span class="astronaut__helmet">
          <span class="astronaut__visor"></span>
        </span>
      </div>
    </div>

    <div class="notfound__foreground">
      <h1 class="sr-only">404 — page not found</h1>
      <p class="notfound__lede">Page not found. It may have moved.</p>

      <div class="btn-row" style="justify-content:center;margin-top:1rem">
        <a class="btn" data-magnetic href={waLink("Hi Harinda, I hit a broken link on your site:")}>Message on WhatsApp</a>
        <a class="btn btn--grad" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </div>
      <p style="margin-top:1.5rem">
        <a class="text-link" href="/">Go to the home page</a>
      </p>
    </div>
  </div>
</BaseLayout>
