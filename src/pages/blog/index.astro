---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { breadcrumb } from "../../lib/schema.js";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const jsonLd = [breadcrumb([
  { name: "Home", path: "/" },
  { name: "Blog", path: "/blog/" },
])];
---

<BaseLayout
  title="Blog"
  description="Notes on photo editing, web development and pattern design — for photographers, business owners and brands, written without jargon."
  path="/blog/"
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Blog</span>
        <h1 class="h1"><span class="split">Notes on photo editing, web builds and pattern design.</span></h1>
        <p>
          Practical writing for photographers deciding how to handle their
          galleries, business owners sourcing a website, and brands ordering
          custom polo and golf shirt designs — no jargon, no sales pitch.
        </p>
      </div>

      <div class="field blog-search">
        <label for="blog-search-input" class="sr-only">Search articles</label>
        <input
          type="search"
          id="blog-search-input"
          placeholder={`Search ${posts.length} articles…`}
          autocomplete="off"
        />
      </div>

      <p class="blog-search__empty" id="blog-search-empty" hidden>
        No articles match that search. Try a different word.
      </p>

      <div class="blog-grid" id="blog-grid">
        {
          posts.map((post) => (
            <a class="card blog-card rise" href={`/blog/${post.id}/`} data-spot>
              <p class="blog-card__date">
                {post.data.publishDate.toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <h2 class="blog-card__title">{post.data.title}</h2>
              <p class="blog-card__desc">{post.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <script>
    const input = document.getElementById("blog-search-input");
    const grid = document.getElementById("blog-grid");
    const empty = document.getElementById("blog-search-empty");
    if (input && grid && empty) {
      const cards = Array.from(grid.querySelectorAll(".blog-card"));
      const haystacks = cards.map((card) =>
        (card.textContent || "").toLowerCase()
      );
      input.addEventListener("input", () => {
        const query = input.value.trim().toLowerCase();
        let visible = 0;
        cards.forEach((card, i) => {
          const match = query === "" || haystacks[i].includes(query);
          card.hidden = !match;
          if (match) visible++;
        });
        empty.hidden = visible !== 0;
      });
    }
  </script>
</BaseLayout>
