---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import site, { waLink } from "../data/site.js";
import { service, faqPage, breadcrumb } from "../lib/schema.js";

const meta = {
  route: "/fashion-designing/",
  title: "Custom Polo & Golf Shirt Design — Print-Ready Patterns",
  description: "Custom polo and golf shirt designs with front and back mockups and print-ready AI, PDF and PNG files. Sublimation-ready patterns from $10.",
};
const services = [
  {
    h: "Golf & polo shirt design.",
    p: "Front and back designs built for the garment, not a logo stretched onto a template. Placement and scale that actually sit right on a collar and a sleeve.",
  },
  {
    h: "Print pattern design.",
    p: "Repeat patterns for fabric and print — golf motifs, textile prints, all-over patterns — tiled cleanly so they hold up at production size.",
  },
  {
    h: "Textile design.",
    p: "Original artwork for fabric, from a single motif to a full colourway set across a range.",
  },
  {
    h: "Mockups, every order.",
    p: "A realistic front and back mockup so you can see the design on the actual shirt before anything goes to print.",
  },
  {
    h: "Source files included.",
    p: "Ai, PDF, PNG and JPG — the formats a print shop, embroiderer, or supplier can actually run with, at commercial-use resolution.",
  },
];

const steps = [
  {
    h: "Message me first.",
    p: "Tell me the garment, the brand or team, and roughly what you're picturing — before placing an order.",
  },
  {
    h: "Send your idea.",
    p: "A logo, a reference photo, a rough sketch, or just a description of the look you want.",
  },
  {
    h: "Concepts come back.",
    p: "One to five initial concepts depending on the package, each with a front and back mockup.",
  },
  {
    h: "Revise until it's right.",
    p: "Revisions are unlimited on every package — there's no extra charge for changes.",
  },
  {
    h: "Get your files.",
    p: "Ai, PDF, PNG and JPG, at printable resolution and cleared for commercial use.",
  },
];

const packages = [
  {
    name: "Basic",
    price: 10,
    designs: "1 design",
    delivery: "1-day delivery",
    desc: "1 print-ready pattern polo t-shirt design and mockup, with Ai, PDF, PNG and JPG files.",
    features: [
      "Unlimited revisions",
      "1 initial concept",
      "Source file included",
      "Printable resolution file",
      "Front & back design",
      "Enhanced detailing",
      "Commercial use",
    ],
  },
  {
    name: "Standard",
    price: 25,
    designs: "3 designs",
    delivery: "2-day delivery",
    desc: "3 print-ready pattern polo t-shirt designs and mockups, with Ai, PDF, PNG and JPG files.",
    featured: true,
    features: [
      "Unlimited revisions",
      "3 initial concepts",
      "Source file included",
      "Printable resolution file",
      "Front & back design",
      "Enhanced detailing",
      "Commercial use",
    ],
  },
  {
    name: "Premium",
    price: 40,
    designs: "5 designs",
    delivery: "2-day delivery",
    desc: "5 print-ready pattern polo t-shirt designs and mockups, with Ai, PDF, PNG and JPG files.",
    features: [
      "Unlimited revisions",
      "5 initial concepts",
      "Source file included",
      "Printable resolution file",
      "Front & back design",
      "Enhanced detailing",
      "Commercial use",
    ],
  },
];

const faqs = [
  {
    q: "Is this the same as technical patternmaking for manufacturing?",
    a: "No. This is fashion and graphic pattern design — the artwork, repeat patterns and mockups that go onto a polo or golf shirt. It doesn't include cut-and-sew patterns, grading, or factory tech packs. If that's what you need, mention it when you message me and I'll point you the right way.",
  },
  {
    q: "Can you design for shirts other than polos?",
    a: "Yes. Golf shirts and similar garments are no problem. Polo and golf shirts are the specialty, so send your garment and I'll tell you straight away if it's a fit.",
  },
  {
    q: "What files do I get?",
    a: "Ai (editable vector source), PDF, PNG and JPG, all at print resolution and cleared for commercial use.",
  },
  {
    q: "How many revisions do I get?",
    a: "Unlimited, on every package, until the design is right. There's no extra charge for changes.",
  },
  {
    q: "How fast is delivery?",
    a: "Basic is 1-day delivery. Standard and Premium, with more concepts to develop, are 2 days.",
  },
  {
    q: "Do I get a mockup, or just the flat artwork?",
    a: "Both. Every package includes a front and back mockup on the actual garment, plus the flat, print-ready artwork files.",
  },
  {
    q: "What if I need more than 5 designs, or a full collection?",
    a: "Message me before ordering. Bulk orders and full seasonal collections are quoted separately from the standard packages.",
  },
];

const waMsg =
  "Hi Harinda, here's a design I'd like a polo/golf shirt pattern and mockup for:";


const crumbs = [{ name: "Home", path: "/" }, { name: "Polo & golf shirt design", path: meta.route }];
const jsonLd = [service({ name: "Polo and golf shirt design", path: meta.route, description: meta.description, offers: 10 }), faqPage(faqs), breadcrumb(crumbs)];
---
<BaseLayout rawTitle={meta.title} description={meta.description} path={meta.route} jsonLd={jsonLd} image="/og/og-polo-design.jpg">
  <PageHero eyebrow="Polo & golf shirt design" title="Custom polo and golf shirt design with print-ready patterns" lede="Front and back designs built for the garment, not a logo stretched onto a template. Made in Illustrator and Photoshop, delivered with realistic mockups and files a printer can run." crumbs={crumbs}>
    <div class="btn-row" style="margin-top:.75rem">
      <a class="btn btn--p" href={waLink(waMsg)} data-track="whatsapp">Start your design brief</a>
      <a class="btn btn--s" href="#pricing">See packages</a>
    </div>
  </PageHero>

  <section class="sec sec--top0">
    <div class="wrap">
      <div class="head"><span class="eyebrow">What you get</span><h2 class="h2">From concept to print-ready files.</h2></div>
      <div class="grid g3" data-rise>{services.map((f) => <article class="card"><h3>{f.h}</h3><p>{f.p}</p></article>)}</div>
    </div>
  </section>

  <section class="sec sec--alt" id="pricing">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Packages</span><h2 class="h2">Three packages. Unlimited revisions on all of them.</h2></div>
      <div class="grid g3" data-rise>
        {packages.map((p) => (
          <article class={`pc${p.featured ? " pc--hot" : ""}`}>
            {p.featured && <span class="pc__tag">Most popular</span>}
            <div class="pc__k">{p.name} · {p.designs}</div>
            <div class="pc__v">${p.price}</div>
            <div class="pc__u">{p.delivery}</div>
            <ul class="checks" style="margin-top:1rem">{p.features.map((f) => <li>{f}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="price-note">All prices in USD. More than 5 designs or a full collection? Message me for a separate quote.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap grid g2" style="align-items:start">
      <div>
        <span class="eyebrow">How it works</span>
        <h2 class="h2" style="margin:.75rem 0 1.5rem">Five steps to print-ready artwork.</h2>
        <ol class="steps">{steps.map((s) => <li><div><b>{s.h}</b><p>{s.p}</p></div></li>)}</ol>
      </div>
      <div>
        <span class="eyebrow">Questions</span>
        <h2 class="h2" style="margin:.75rem 0 1.25rem">Polo design FAQ</h2>
        <Faq items={faqs} />
      </div>
    </div>
  </section>
  <Cta title="Send me your idea" text="A logo, a sketch or just a description. Concepts with front and back mockups come back in 1–2 days." href={waLink(waMsg)} label="Start on WhatsApp" />
</BaseLayout>
