---
import BaseLayout from "../layouts/BaseLayout.astro";
import site, { waLink } from "../data/site.js";
import { professionalService, breadcrumb } from "../lib/schema.js";

const jsonLd = [
  professionalService(),
  breadcrumb([
    { name: "Home", path: "/" },
    { name: "Contact", path: "/contact/" },
  ]),
];
---

<BaseLayout
  title="Contact"
  description="Ask for a free sample edit or a fixed-price quote — photo editing, web development, or fashion designing. Message on WhatsApp or send the form. Serving the US, Canada and Europe."
  path="/contact/"
  jsonLd={jsonLd}
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Contact</span>
        <h1 class="h1"><span class="split">Tell me about the project.</span></h1>
        <p>
          Photo editing, a website, or a fashion design project — say what you
          need and you get a reply within one working day. The fastest route
          is WhatsApp; the form below reaches the same inbox.
        </p>
      </div>

      <div class="contact-grid">
        <div class="card">
          {/* Status messages. contact.php redirects here with #sent or #error;
              shown via :target, so no JavaScript is needed. */}
          <div id="sent" class="alert alert--ok alert--toggle" role="status">
            <strong>Message sent.</strong> Thanks — you&rsquo;ll hear back within
            one working day. If it&rsquo;s urgent, message on WhatsApp.
          </div>
          <div id="error" class="alert alert--err alert--toggle" role="alert">
            <strong>That didn&rsquo;t go through.</strong> Please email
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or
            message on WhatsApp instead.
          </div>

          <form method="POST" action="/contact.php">
            <label class="field">
              <span>Your name</span>
              <input type="text" name="name" autocomplete="name" required />
            </label>

            <label class="field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required />
            </label>

            <label class="field">
              <span>Which service?</span>
              <select name="service">
                <option value="">Not sure yet</option>
                {
                  site.contact.services.map((s) => (
                    <option value={s}>{s}</option>
                  ))
                }
              </select>
            </label>

            <label class="field">
              <span>What do you need?</span>
              <textarea
                name="message"
                rows="6"
                required
                placeholder="Photo work: type of shoot, the look you're after, roughly how many photos, deadline, file format. Web or fashion design: what you're building and any timeline."
              ></textarea>
            </label>

            {/* Honeypot — hidden from people, catches bots. */}
            <div class="field--hp" aria-hidden="true">
              <label>
                Company
                <input type="text" name="company" tabindex="-1" autocomplete="off" />
              </label>
            </div>

            <button class="btn" data-magnetic type="submit">Send message</button>
            <p class="form-note">
              Photo editing includes a free sample edit and is paid only after
              the photos are delivered and approved — no deposit. Web and
              fashion design projects start with a free scope call before any
              price is agreed.
            </p>
          </form>
        </div>

        <aside>
          <div class="aside-block">
            <h2>WhatsApp</h2>
            <p><a class="text-link" href={waLink("Hi Harinda, I found your site and I'd like to talk about a project.")}>{site.contact.whatsappDisplay}</a></p>
            <p class="form-note">{site.contact.whatsappNote}</p>
          </div>
          <div class="aside-block">
            <h2>Fiverr</h2>
            <p><a class="text-link" href={site.contact.fiverr} target="_blank" rel="noopener">fiverr.com/iamharinda</a></p>
            <p class="form-note">Book with buyer protection through Fiverr.</p>
          </div>
          <div class="aside-block">
            <h2>Email</h2>
            <p><a class="text-link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
          </div>
          <div class="aside-block">
            <h2>Areas served</h2>
            <p>{site.areasServed.join(" · ")}</p>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
