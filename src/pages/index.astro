---
import BaseLayout from "../layouts/BaseLayout.astro";
import Bits from "../components/Bits.astro";
import Shot from "../components/Shot.astro";
import Pricing from "../components/Pricing.astro";
import Reviews from "../components/Reviews.astro";
import WorldMap from "../components/WorldMap.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import site, { waLink } from "../data/site.js";
import { portfolio, pick, cld, cldSrcset } from "../data/portfolio.js";
import { service, faqPage } from "../lib/schema.js";
import { getCollection } from "astro:content";

const hero = pick("DSC01850")[0];
const heroSizes = "100vw";
const heroWidths = [640, 960, 1280, 1600, 2000];
const fe = site.featuredEdit;
const railImgs = pick("DSC_0943-Enhanced-NR", "DSC01720", "IMG_9342", "IMG_3960", "DSC_0960-Enhanced-NR", "IMG_8873", "DSC02117", "IMG_3993");
const printImg = pick("DSC_0972-Enhanced-NR")[0];
const faqs = site.faqs.slice(0, 5);
const posts = (await getCollection("blog", (p) => p.data.category === "photo-editing"))
  .sort((a, b) => b.data.publishDate - a.data.publishDate)
  .slice(0, 3);

const jsonLd = [
  service({ name: "Photo editing for photographers", path: "/photo-editing/", description: site.description }),
  faqPage(faqs),
];
---

<BaseLayout
  rawTitle="Wedding & Portrait Photo Editing, Hand-Edited | Harinda"
  description="Outsource your wedding and portrait editing to a human editor. Lightroom, no AI, from $0.20 a photo. 3 free sample edits, pay after you approve."
  path="/"
  jsonLd={jsonLd}
  preloadImage={cld(hero, { w: 1280 })}
  preloadSrcset={heroWidths.map((w) => `${cld(hero, { w })} ${w}w`).join(", ")}
  preloadSizes={heroSizes}
>
  <header class="hero">
    <div class="hero__frame">
      <img
        src={cld(hero, { w: 1280 })}
        srcset={heroWidths.map((w) => `${cld(hero, { w })} ${w}w`).join(", ")}
        sizes={heroSizes}
        width="1280"
        height={Math.round((1280 * hero.h) / hero.w)}
        alt={hero.alt}
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero__copy">
        <span class="eyebrow">Wedding &amp; portrait editing · No AI</span>
        <h1 class="display" style="margin-top:.9rem">
          <span class="ln"><span>Your style.</span></span>
          <span class="ln"><span><em>Hand-edited.</em></span></span>
          <span class="ln"><span>On deadline.</span></span>
        </h1>
        <p>I edit wedding, portrait and event galleries in Lightroom Classic, by eye, on a calibrated screen. Three free sample edits first. You pay after you approve.</p>
        <div class="btn-row">
          <a class="btn btn--p" href="/free-sample/">{site.freeSample.cta}</a>
          <a class="btn btn--s btn--light" href="/work/">See the work</a>
        </div>
        <p class="hero__rating"><span class="stars" aria-hidden="true">★★★★★</span> {site.fiverrStats.rating} · {site.fiverrStats.reviews}+ Fiverr reviews · {site.fiverrStats.ordersPlus}+ orders</p>
      </div>
      <div class="hero__meta">ASUS ProArt · Calman Verified<br />Lightroom Classic · Photoshop<br />From {site.perPhoto} a photo</div>
    </div>
  </header>

  <Bits kind="guarantees" />

  <!-- How I edit: real Lightroom settings from a real client photo -->
  <section class="sec" id="how-i-edit">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">How I edit</span>
        <h2 class="h2">Real settings from a real gallery.</h2>
        <p class="lede">These are the exact Lightroom Classic values saved in this bridal shower photo. Scroll and watch them land. Every frame gets the same care: exposure first, then tone, then color, then a final check on a calibrated screen.</p>
      </div>
      <div class="edit" data-edit>
        <figure class="edit__photo" data-parallax>
          <img src={cld(fe, { w: 1280, ar: "3:2" })} srcset={cldSrcset(fe, [640, 960, 1280, 1600], { ar: "3:2" })} sizes="(min-width: 861px) 60vw, 100vw" width="1280" height="853" alt={fe.alt} loading="lazy" decoding="async" />
        </figure>
        <div class="panel" aria-label="Lightroom Classic develop settings for this photo">
          <div class="panel__top"><span>Develop · Basic</span><span data-pct>100%</span></div>
          {fe.settings.map((s) => (
            <div class="sl" data-sl data-v={s.value} data-min={s.min} data-max={s.max} data-dec={s.dec ?? 0}>
              <span>{s.label}</span>
              <div class="track"><i class="knob" style={`--k:${((s.value - s.min) / (s.max - s.min)) * 100}%`}></i></div>
              <output>{(s.value > 0 ? "+" : s.value < 0 ? "−" : "") + Math.abs(s.value).toFixed(s.dec ?? 0)}</output>
            </div>
          ))}
          <div class="panel__passes">{fe.passes.map((p) => <span class="pill">{p}</span>)}</div>
          <p class="panel__foot">{fe.camera}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="sec sec--alt sec--tight">
    <div class="wrap"><Bits kind="stats" /></div>
  </section>

  <WorldMap />

  <!-- Work rail -->
  <section class="sec" id="work">
    <div class="wrap head head--row">
      <div>
        <span class="eyebrow">The work</span>
        <h2 class="h2">Finished galleries, not filters.</h2>
      </div>
      <p class="muted" style="max-width:30em">Weddings and events, portraits, product and food, all edited by hand for clients in {site.fiverrStats.countries} countries. <a class="link" href="/work/">Full portfolio</a></p>
    </div>
    <div class="rail" data-rail>
      <div class="rail__track">
        {railImgs.map((img) => <div class="rail__item"><Shot img={img} sizes="(min-width: 900px) 30vw, 80vw" /></div>)}
      </div>
    </div>
  </section>

  <!-- Process with 3D print -->
  <section class="sec sec--alt">
    <div class="wrap grid g2" style="align-items:center">
      <div class="stage">
        <div class="print" data-print>
          <div class="print__face">
            <img src={cld(printImg, { w: 640, ar: "4:5" })} width="640" height="800" alt={printImg.alt} loading="lazy" decoding="async" />
            <div class="print__cap"><span>Edited by Harinda</span><span>sRGB · Full res</span></div>
          </div>
          <div class="print__face print__back" aria-hidden="true">
            <span class="eyebrow">Delivery note</span>
            <h3>Gallery ready.</h3>
            <dl>
              <dt>Images</dt><dd>500 edited</dd>
              <dt>Turnaround</dt><dd>4 days</dd>
              <dt>Format</dt><dd>JPEG · sRGB · full res</dd>
              <dt>Delivery</dt><dd>Google Drive link</dd>
              <dt>Revisions</dt><dd>Unlimited</dd>
            </dl>
          </div>
        </div>
      </div>
      <div>
        <span class="eyebrow">How it works</span>
        <h2 class="h2" style="margin:.75rem 0 1.5rem">From memory card to finished gallery.</h2>
        <ol class="steps">
          <li><div><b>Send a link</b><p>Google Drive, Dropbox or WeTransfer, plus your preset or three reference edits.</p></div></li>
          <li><div><b>Free sample, {site.freeSample.turnaround}</b><p>Three photos edited in your style, so we agree on the look before anything is paid.</p></div></li>
          <li><div><b>Full gallery in 2–4 days</b><p>Every frame edited by hand and delivered at full resolution.</p></div></li>
          <li><div><b>Approve, then pay</b><p>Unlimited revisions. Pay by PayPal, Payoneer, Remitly, TapSend or bank transfer.</p></div></li>
        </ol>
        <p style="margin-top:1.5rem"><a class="link" href="/photo-editing/how-to-send-files/">How to send your files</a></p>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section class="sec" id="pricing">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Pricing</span>
        <h2 class="h2">{site.perPhoto} a photo, edited by hand.</h2>
        <p class="lede">One price ladder for weddings, portraits, events and products. Direct orders are paid after you approve the gallery.</p>
      </div>
      <Pricing />
      <p style="margin-top:1rem"><a class="link" href="/pricing/">Compare ordering direct and on Fiverr</a></p>
    </div>
  </section>

  <Reviews />

  <!-- About -->
  <section class="sec">
    <div class="wrap grid g2" style="align-items:center">
      <figure class="ph ph--3x2" data-parallax>
        <img src={site.aboutImage.src} width={site.aboutImage.width} height={site.aboutImage.height} alt={site.aboutImage.alt} loading="lazy" decoding="async" />
      </figure>
      <div>
        <span class="eyebrow">Meet your editor</span>
        <h2 class="h2" style="margin:.75rem 0 1rem">Hi, I'm Harinda. I edit every photo myself.</h2>
        <p class="lede">A former photographer, now a full-time editor. No team, no AI looks: the person you message is the person who edits your gallery, on a factory-calibrated screen.</p>
        <div class="chips" style="margin-top:1.25rem">
          <span class="pill">ASUS ProArt · Calman Verified</span><span class="pill">Lightroom Classic</span><span class="pill">Photoshop</span><span class="pill">Replies {site.replyTime}</span>
        </div>
        <p style="margin-top:1.5rem"><a class="link" href="/about/">More about me</a></p>
      </div>
    </div>
  </section>

  <!-- Also from Harinda -->
  <section class="sec sec--top0">
    <div class="wrap">
      <span class="eyebrow">Also from Harinda</span>
      <div class="grid g2" style="margin-top:1rem">
        {site.otherServices.map((s) => (
          <a class="card card--link" href={s.href}><h3>{s.label}</h3><p>{s.line}</p><span class="link" style="margin-top:auto">Learn more</span></a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec--alt">
    <div class="wrap grid g2" style="align-items:start">
      <div>
        <span class="eyebrow">Questions</span>
        <h2 class="h2" style="margin:.75rem 0 1.25rem">Before you send a gallery.</h2>
        <Faq items={faqs} />
      </div>
      <div>
        <span class="eyebrow">From the blog</span>
        <h2 class="h2" style="margin:.75rem 0 1.25rem">Guides for wedding photographers.</h2>
        <div class="grid">
          {posts.map((p) => (
            <a class="post-card" href={`/blog/${p.id}/`}><span class="mono">{p.data.publishDate.toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" })}</span><h3>{p.data.title}</h3></a>
          ))}
        </div>
        <p style="margin-top:1.25rem"><a class="link" href="/blog/category/photo-editing/">All photo editing guides</a></p>
      </div>
    </div>
  </section>

  <Cta />
</BaseLayout>
