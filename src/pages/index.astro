---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import site, { waLink } from "../data/site.js";
import { professionalService, faqPage } from "../lib/schema.js";

const jsonLd = [professionalService(), faqPage(site.faqs)];
const sampleMsg =
  "Hi Harinda, I found your site. Could you do a free sample edit of a few of my photos?";
const { rating, reviews } = site.fiverrStats;
const av = site.availability;
const icons = ["◐", "◔", "◑", "◕"];
---

<BaseLayout
  title="Human photo editing and colour correction"
  description={site.description}
  path="/"
  jsonLd={jsonLd}
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__text">
      <span
        class="presence"
        data-on={String(av.on)}
        title={av.on ? av.onLabel : av.offLabel}
      >
        <span class="presence__ring" aria-hidden="true">
          <img
            class="presence__avatar"
            src={site.personImage}
            width="104"
            height="104"
            alt={`${site.personName}, photo editor`}
            loading="eager"
            decoding="async"
          />
          <span class="presence__dot"></span>
        </span>
        <span class="presence__meta">
          <b>{site.personName}</b>
          <span>{av.on ? "online" : "currently booked"}</span>
        </span>
      </span>

      <h1 class="h1">
        <span class="split">Colour correction and retouching, by a human eye.</span>
      </h1>
      <p>
        {site.tagline} No AI presets, no batch looks — skin stays skin, whites
        stay white. See it first with a free sample edit.
      </p>
      <div class="btn-row">
        <a class="btn" data-magnetic href={waLink(sampleMsg)}>{site.freeSample.cta}</a>
        <a class="btn btn--ghost" href="/pricing/">See pricing</a>
      </div>
      <p class="hero__trust">
        Rated {rating} on <a href={site.contact.fiverr} target="_blank" rel="noopener">Fiverr</a>
        over {reviews} reviews · {site.fiverrStats.ordersPlus}+ orders · pay after delivery
      </p>
      <div class="hero__pills">
        {site.services.slice(0, 5).map((s) => <span class="pill">{s}</span>)}
      </div>
    </div>
  </section>

  <!-- ── What you get ─────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What you get</span>
        <h2 class="h2 reveal">Editing decisions made by a person, not a model.</h2>
        <p>Every frame is opened on a calibrated screen and judged by eye.</p>
      </div>
      <div class="grid">
        {
          site.whatYouGet.map((f, i) => (
            <article class="card feature rise" data-spot data-tilt>
              <div class="feature__icon" aria-hidden="true">{icons[i % icons.length]}</div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Free sample callout ─────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="callout beam rise">
        <div>
          <h2 class="grad-text">{site.freeSample.short}</h2>
          <p>{site.freeSample.line} No card, no commitment.</p>
        </div>
        <a class="btn" data-magnetic href={waLink(sampleMsg)}>{site.freeSample.cta}</a>
      </div>
    </div>
  </section>

  <!-- ── Pricing snapshot ─────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pricing</span>
        <h2 class="h2 reveal">Priced by volume. Paid after delivery.</h2>
        <p>Three flat packages. Larger sets are quoted individually.</p>
      </div>
      <div class="price-grid">
        {
          site.packages.map((p, i) => (
            <article class={`card price-card rise${i === 1 ? " price-card--featured beam" : ""}`} data-spot>
              <div class="price-card__photos">{p.photos} photos</div>
              <div class="price-card__amount grad-text">${p.price}</div>
              <div class="price-card__unit">
                ${(p.price / p.photos).toFixed(2)} per photo, all in
              </div>
            </article>
          ))
        }
      </div>
      <p class="bulk-note rise">{site.bulkNote}</p>
      <p style="margin-top:1.5rem">
        <a class="text-link" href="/pricing/">Full pricing and payment methods</a>
      </p>
    </div>
  </section>

  <!-- ── How it works ────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2 class="h2 reveal">Four steps, no deposit.</h2>
      </div>
      <ol class="steps">
        {
          site.howItWorks.map((step) => (
            <li class="step rise">
              <span class="step__n" aria-hidden="true" />
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── Tools ───────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The setup</span>
        <h2 class="h2 reveal">Judged on true colour, edited by hand.</h2>
        <p>The screen and software behind every file.</p>
      </div>
      <div class="tools-grid">
        {
          site.toolLogos.map((t) => (
            <div class="tool-card rise" data-spot>
              <span class="tool-card__logo" aria-hidden="true">
                {t.icon === "asus" && (
                  <svg viewBox="0 0 48 48" fill="none">
                    <rect x="5" y="8" width="38" height="25" rx="3" stroke="currentColor" stroke-width="2.4" />
                    <path d="M18 40h12M24 33v7" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
                    <path d="M12 21l5 5 9-10" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {t.icon === "lrc" && (
                  <svg viewBox="0 0 48 48">
                    <rect width="48" height="48" rx="10" fill="#00232D" />
                    <text x="24" y="31" text-anchor="middle" font-family="Georgia, serif" font-size="20" fill="#31C5F0">Lr</text>
                  </svg>
                )}
                {t.icon === "lr" && (
                  <svg viewBox="0 0 48 48">
                    <rect width="48" height="48" rx="10" fill="#0F6FB8" />
                    <text x="24" y="31" text-anchor="middle" font-family="Georgia, serif" font-size="20" fill="#EAF6FF">Lr</text>
                  </svg>
                )}
                {t.icon === "ps" && (
                  <svg viewBox="0 0 48 48">
                    <rect width="48" height="48" rx="10" fill="#001E36" />
                    <text x="24" y="31" text-anchor="middle" font-family="Georgia, serif" font-size="20" fill="#31A8FF">Ps</text>
                  </svg>
                )}
                {t.icon === "drive" && (
                  <svg viewBox="0 0 48 48">
                    <path d="M17.5 6h13l13 22.5-6.5 11h-26l-6.5-11z" fill="#EBEBEB" />
                    <path d="M17.5 6l-13 22.5 6.5 11 13-22.5z" fill="#2684FC" />
                    <path d="M30.5 6l13 22.5-6.5 11-13-22.5z" fill="#00AC47" />
                    <path d="M11 28.5h26l-6.5 11h-13z" fill="#FFBA00" />
                  </svg>
                )}
              </span>
              <span class="tool-card__name">{t.name}</span>
              <span class="tool-card__note">{t.note}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── FAQ ─────────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2 class="h2 reveal">Frequently asked.</h2>
      </div>
      <FaqAccordion items={site.faqs} />
    </div>
  </section>

  <!-- ── Contact CTA ─────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container center-narrow">
      <h2 class="h1 shine">Start with a free sample edit.</h2>
      <p class="lede" style="margin-top:1rem;margin-inline:auto">
        Send two or three RAW files. You get them back fully edited, free, and you
        decide from there. Full orders are paid only after delivery.
      </p>
      <div class="btn-row" style="margin-top:1.75rem;justify-content:center">
        <a class="btn" data-magnetic href={waLink(sampleMsg)}>Message on WhatsApp</a>
        <a class="btn btn--grad" href={site.contact.fiverr} target="_blank" rel="noopener">Book on Fiverr</a>
      </div>
    </div>
  </section>

  <!-- ── Reviews — kept last so the sections above are seen first ─────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Reviews</span>
        <h2 class="h2 reveal">{rating} out of 5 on Fiverr.</h2>
        <p>
          From {reviews} reviews over {site.fiverrStats.ordersPlus}+ orders.
        </p>
      </div>
      <div class="quotes">
        {
          site.testimonials.map((t) => (
            <figure class="card quote rise" data-spot>
              <div class="stars" aria-hidden="true">★★★★★</div>
              <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
              <figcaption>
                <b>{t.name}</b>
                <br />
                {t.role}
              </figcaption>
            </figure>
          ))
        }
      </div>
      <p style="margin-top:1.75rem">
        <a class="text-link" href={site.contact.fiverr} target="_blank" rel="noopener">Read all reviews on Fiverr</a>
      </p>
    </div>
  </section>
</BaseLayout>
