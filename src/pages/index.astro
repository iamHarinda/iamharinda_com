---
import BaseLayout from "../layouts/BaseLayout.astro";
import BeforeAfter from "../components/BeforeAfter.jsx";
import FaqAccordion from "../components/FaqAccordion.jsx";
import Sample from "../components/Sample.astro";
import site, { waLink, priceRange } from "../data/site.js";
import { professionalService, faqPage } from "../lib/schema.js";

const homeSamples = site.samples.slice(0, 3);
const jsonLd = [professionalService(), faqPage(site.faqs)];
const orderMsg = "Hi Harinda, I found you through your site and I'd like a quote for photo editing.";
---

<BaseLayout
  title="Human photo editing and colour correction"
  description={site.description}
  path="/"
  jsonLd={jsonLd}
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__text">
      <h1>Colour correction and retouching, done by a human eye.</h1>
      <p>{site.tagline} No AI presets, no one-click batch looks. Skin stays skin, whites stay white.</p>
      <div class="btn-row">
        <a class="btn" href={waLink(orderMsg)}>Start on WhatsApp</a>
        <a class="btn btn--ghost" href="/pricing/">See pricing</a>
      </div>
    </div>

    <figure class="hero__figure">
      <BeforeAfter
        client:load
        variant="hero"
        eager
        priority
        before={site.hero.before}
        after={site.hero.after}
        width={site.hero.width}
        height={site.hero.height}
      />
      <figcaption>Drag the handle to compare the original file with the finished edit.</figcaption>
    </figure>
  </section>

  <!-- ── What you get ─────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What you get</span>
        <h2 class="h2">Editing decisions made by a person, not a model.</h2>
        <p>Every frame is opened on a calibrated screen and judged by eye. Here is what that changes.</p>
      </div>
      <div class="grid">
        {
          site.whatYouGet.map((f) => (
            <div class="feature">
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Sample before/afters ─────────────────────────────────────────── -->
  <section class="section section--dim">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Sample work</span>
        <h2 class="h2">A few before and afters.</h2>
        <p>Replace these with your own shoots. Each one is a real slider — drag to compare.</p>
      </div>
      <div class="samples">
        {homeSamples.map((s) => <Sample sample={s} />)}
      </div>
      <p style="margin-top:2.5rem">
        <a class="text-link" href="/work/">See more work</a>
      </p>
    </div>
  </section>

  <!-- ── Pricing snapshot ─────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Pricing</span>
        <h2 class="h2">Priced by volume. Paid after delivery.</h2>
        <p>Three flat packages. Larger sets are quoted individually.</p>
      </div>
      <div class="price-grid">
        {
          site.packages.map((p) => (
            <div class="price-card">
              <div class="price-card__photos">{p.photos} photos</div>
              <div class="price-card__amount">${p.price}</div>
              <div class="price-card__unit">
                ${(p.price / p.photos).toFixed(2)} per photo, all in
              </div>
            </div>
          ))
        }
      </div>
      <p class="bulk-note">{site.bulkNote}</p>
      <p style="margin-top:1.5rem">
        <a class="text-link" href="/pricing/">Full pricing and payment methods</a>
      </p>
    </div>
  </section>

  <!-- ── How it works (numbered) ─────────────────────────────────────── -->
  <section class="section section--band">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2 class="h2">Four steps, no deposit.</h2>
      </div>
      <ol class="steps">
        {
          site.howItWorks.map((step) => (
            <li class="step">
              <span class="step__n" aria-hidden="true" />
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ── Testimonials ────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">In their words</span>
        <h2 class="h2">What clients say.</h2>
        <p>TODO — swap these for real, verbatim quotes from your Fiverr reviews.</p>
      </div>
      <div class="quotes">
        {
          site.testimonials.map((t) => (
            <figure class="quote">
              <blockquote>&ldquo;{t.quote}&rdquo;</blockquote>
              <figcaption>
                <b>{t.name}</b>
                <br />
                {t.role}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── FAQ ─────────────────────────────────────────────────────────── -->
  <section class="section section--dim">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Questions</span>
        <h2 class="h2">Frequently asked.</h2>
      </div>
      <FaqAccordion client:visible items={site.faqs} />
    </div>
  </section>

  <!-- ── Contact CTA ─────────────────────────────────────────────────── -->
  <section class="section section--band">
    <div class="container center-narrow">
      <h2 class="h2">Send a test batch.</h2>
      <p style="margin-top:.75rem;color:var(--on-band-soft)">
        Message on WhatsApp or book through Fiverr. Send five or ten RAW files and
        see the edits before you commit to a full shoot. You pay after delivery.
      </p>
      <div class="btn-row" style="margin-top:1.5rem">
        <a class="btn" href={waLink(orderMsg)}>Message on WhatsApp</a>
        <a class="btn btn--ghost" href={site.contact.fiverr} target="_blank" rel="noopener">Book on Fiverr</a>
      </div>
    </div>
  </section>
</BaseLayout>
