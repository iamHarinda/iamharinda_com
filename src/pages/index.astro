---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorldMap from "../components/WorldMap.astro";
import site, { waLink } from "../data/site.js";
import { professionalService } from "../lib/schema.js";

const jsonLd = [professionalService()];
const av = site.availability;
const contactMsg =
  "Hi Harinda, I found your site. I'm not sure which service I need — can you help?";
---

<BaseLayout
  title="Photo Editing, Web Development & Fashion Design"
  description="Harinda Fernando runs three services from Sri Lanka for clients in the US, Canada and Europe: photo editing, custom web development, and fashion designing."
  path="/"
  jsonLd={jsonLd}
>
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="container hero__text">
      <span
        class="presence"
        data-on={String(av.on)}
        title={av.on ? av.onLabel : av.offLabel}
      >
        <span class="presence__ring" aria-hidden="true">
          <img
            class="presence__avatar"
            src={site.personImage}
            width="104"
            height="104"
            alt={`${site.personName}, photo editor and web developer`}
            loading="eager"
            decoding="async"
          />
          <span class="presence__dot"></span>
        </span>
        <span class="presence__meta">
          <b>{site.personName}</b>
          <span>{av.on ? "online" : "currently booked"}</span>
        </span>
      </span>

      <h1 class="h1">
        <span class="split">One person. Photo editing, web builds, and fashion designing.</span>
      </h1>
      <p>
        I run three services for clients in the United States, Canada and Europe.
        Pick the one you need — each has its own page, its own pricing, and its
        own turnaround.
      </p>
      <div class="btn-row">
        <a class="btn" data-magnetic href="#services">See the services</a>
        <a class="btn btn--ghost" href="/contact/">Contact</a>
      </div>
    </div>
  </section>

  <!-- ── Services: the front door ─────────────────────────────────────── -->
  <section class="section" id="services">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Services</span>
        <h2 class="h2 reveal">Four things I do. One line each.</h2>
      </div>
      <div class="service-list">
        {
          site.servicePages.map((s) => (
            <a href={s.href}>
              <h3>{s.label}</h3>
              <p>{s.line}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── World map ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <WorldMap heading="Clients, worldwide." />
    </div>
  </section>

  <!-- ── Contact ─────────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container center-narrow">
      <h2 class="h1 shine">Not sure which you need?</h2>
      <p class="lede" style="margin-top:1rem;margin-inline:auto">
        Send a short message about the work and I'll point you to the right
        service, or tell you if it's not something I do.
      </p>
      <div class="btn-row" style="margin-top:1.75rem;justify-content:center">
        <a class="btn" data-magnetic href={waLink(contactMsg)}>Message on WhatsApp</a>
        <a class="btn btn--grad" href="/contact/">Use the contact form</a>
      </div>
      <p class="form-note" style="margin-top:1rem">
        Every enquiry gets a reply within one business day.
      </p>
    </div>
  </section>
</BaseLayout>
