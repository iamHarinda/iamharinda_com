---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Faq from "../components/Faq.astro";
import Cta from "../components/Cta.astro";
import site, { waLink } from "../data/site.js";
import { service, faqPage, breadcrumb } from "../lib/schema.js";

const meta = {
  route: "/web-development/",
  title: "Custom Small Business Websites — No WordPress, No Builders",
  description: "Custom-coded websites and web apps for small businesses. No WordPress, no page builders. Fixed-price projects from $750, with the code handed over to you.",
};
const whatIBuild = [
  {
    h: "Marketing and portfolio sites.",
    p: "Fast, responsive, built to rank. Typically 5–12 pages with a proper content structure rather than everything crammed onto one scrolling page.",
  },
  {
    h: "Sites with a CMS you can actually use.",
    p: "If you need to edit copy, publish posts, or add products yourself, I wire in a headless CMS with fields shaped around your content — not a generic editor you have to fight.",
  },
  {
    h: "Web applications.",
    p: "Booking systems, client portals, dashboards, internal tools, API integrations. Anything where off-the-shelf software nearly fits but not quite.",
  },
  {
    h: "Rescue work.",
    p: "Existing site slow, broken, or built by someone who has since disappeared. I audit it and either fix it or rebuild the parts worth keeping.",
  },
];

const steps = [
  {
    h: "Scope call.",
    p: "Thirty minutes. What the site needs to do, who it's for, what already exists. No charge.",
  },
  {
    h: "Written proposal.",
    p: "Fixed price, page-by-page scope, timeline, and exactly what's included. You approve it before anything starts.",
  },
  {
    h: "Design pass.",
    p: "Wireframes or a design direction agreed before a line of code is written, so we're not rebuilding at the end.",
  },
  {
    h: "Build, with weekly check-ins.",
    p: "You get a live staging link from week one, so you're watching it come together rather than waiting for a reveal.",
  },
  {
    h: "Launch and handover.",
    p: "Domain connected, SSL, analytics, business email set up, and the full source repository transferred to you. The code is yours.",
  },
  {
    h: "Thirty days of support included",
    p: "after launch for fixes and small changes.",
  },
];

const priceRows = [
  ["Single-page site or landing page", "$750"],
  ["Marketing site, up to 8 pages", "$1,500"],
  ["Business site with CMS", "$2,500"],
  ["Web application / custom tooling", "$4,000"],
  ["Ongoing maintenance and updates", "$150 per month"],
  ["Additional work outside agreed scope", "$40 per hour"],
];

const faqs = [
  {
    q: "What stack do you use?",
    a: "Modern JavaScript frameworks for the front end, with the back end chosen to suit the project. I'll name the specific stack in the proposal and explain why.",
  },
  {
    q: "How long does a project take?",
    a: "A landing page is about a week. A marketing site is two to three weeks. Web apps depend on scope and get a dated timeline in the proposal.",
  },
  {
    q: "I'm in the US — how do we handle the time difference?",
    a: "I keep hours that overlap US mornings, and I answer messages within one business day, every business day. Calls are booked at times that work for you.",
  },
  {
    q: "Do I own the code?",
    a: "Yes, entirely. The repository transfers to you at launch. No licence, no lock-in, and you can hire anyone to work on it afterwards.",
  },
  {
    q: "Can you take over a site someone else built?",
    a: "Usually. Send me the repo or hosting access and I'll tell you honestly whether it is worth continuing or rebuilding.",
  },
];

const waMsg =
  "Hi Harinda, I'd like a fixed-price quote for a website. Here's what I'm building:";


const projects = [
  { name: "iamharinda.com", url: "https://www.iamharinda.com/", what: "This site: Astro, static HTML, GSAP motion, a Liquid Glass navbar and Cloudinary images, built to pass Core Web Vitals." },
  { name: "ToolsServer", url: "https://toolsserver.com/", what: "A free online tools site with fast, client-side tools and an Android companion app." },
  { name: "PeriodicElementTable.com", url: "https://periodicelementtable.com/", what: "A chemistry learning site for students, hosted on Hostinger behind Cloudflare." },
];
const crumbs = [{ name: "Home", path: "/" }, { name: "Web development", path: meta.route }];
const jsonLd = [service({ name: "Custom web development", path: meta.route, description: meta.description, offers: 750 }), faqPage(faqs), breadcrumb(crumbs)];
---
<BaseLayout rawTitle={meta.title} description={meta.description} path={meta.route} jsonLd={jsonLd} image="/og/og-web-development.jpg">
  <PageHero eyebrow="Web development" title="Custom website development: fast, hand-coded, yours to keep" lede="Most small business sites are a theme, six plugins and a page builder holding each other up. I write sites from scratch: clean code, no plugin licences, and no ceiling on what the site can do next year." crumbs={crumbs}>
    <div class="btn-row" style="margin-top:.75rem">
      <a class="btn btn--p" href={waLink(waMsg)} data-track="whatsapp">Get a fixed-price quote</a>
      <a class="btn btn--s" href="#pricing">See pricing</a>
    </div>
  </PageHero>

  <section class="sec sec--top0">
    <div class="wrap">
      <div class="head"><span class="eyebrow">What I build</span><h2 class="h2">Four kinds of project.</h2></div>
      <div class="grid g2" data-rise>{whatIBuild.map((f) => <article class="card"><h3>{f.h}</h3><p>{f.p}</p></article>)}</div>
    </div>
  </section>

  <section class="sec sec--alt">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Recent projects</span><h2 class="h2">Built and running.</h2></div>
      <div class="grid g3" data-rise>{projects.map((p) => <a class="card card--link" href={p.url} target="_blank" rel="noopener"><h3>{p.name}</h3><p>{p.what}</p><span class="link" style="margin-top:auto">Visit site</span></a>)}</div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap grid g2" style="align-items:start">
      <div>
        <span class="eyebrow">How I work</span>
        <h2 class="h2" style="margin:.75rem 0 1.5rem">Scope call to handover.</h2>
        <ol class="steps">{steps.map((s) => <li><div><b>{s.h}</b><p>{s.p}</p></div></li>)}</ol>
      </div>
      <div id="pricing">
        <span class="eyebrow">Pricing</span>
        <h2 class="h2" style="margin:.75rem 0 1.5rem">Fixed price, quoted after the scope call.</h2>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Project type</th><th scope="col">From (USD)</th></tr></thead>
            <tbody>{priceRows.map(([l, p]) => <tr><th scope="row">{l}</th><td class="num">{p}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="price-note">$750 is the project minimum. Payment is 40% to start and 60% on launch, by card, Wise or bank transfer.</p>
      </div>
    </div>
  </section>

  <section class="sec sec--alt">
    <div class="wrap narrow prose">
      <span class="eyebrow">The WordPress question</span>
      <h2 class="h2">Why not WordPress?</h2>
      <p>Nothing is wrong with WordPress for a blog. The problem is a business site assembled from a paid theme and a stack of plugins that were never written to work together: a site you can't fully change, performance you can't fix, security patches to chase and yearly licence bills.</p>
      <p>A custom build costs more up front and less over three years. You own the code, it loads fast on a phone, and when you need something new it gets built rather than worked around. If WordPress genuinely is the right answer for your project, I'll say so on the scope call.</p>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <div class="head"><span class="eyebrow">Questions</span><h2 class="h2">Web development FAQ</h2></div>
      <Faq items={faqs} />
    </div>
  </section>
  <Cta title="Get a fixed-price quote" text="Tell me what you're building and get a written scope and a firm number, usually within two business days." href={waLink(waMsg)} label="Message me on WhatsApp" />
</BaseLayout>
