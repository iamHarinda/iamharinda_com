---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import BrandIcon from "../../components/BrandIcon.astro";
import site, { waLink } from "../../data/site.js";
import { breadcrumb } from "../../lib/schema.js";
import { featured } from "../../data/reviews.js";

const quote = featured(1)[0];

const crumbs = [{ name: "Home", path: "/" }, { name: "Free sample edit", path: "/free-sample/" }];
---
<BaseLayout rawTitle="Get 3 Photos Edited Free — Free Sample Photo Editing" description="Send three photos and get them back edited in your style, free, usually within 24 hours. No payment details, no obligation." path="/free-sample/" jsonLd={[breadcrumb(crumbs)]}>
  {site.turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline></script>}
  <PageHero eyebrow="Free sample edit" title="Get 3 photos edited free" lede={`No payment details, no obligation. The edited photos come back ${site.freeSample.turnaround}, so you can judge the style before ordering.`} crumbs={crumbs} />
  <section class="sec sec--top0">
    <div class="wrap grid g-form">
      <div class="card">
        <p class="alert alert--err" id="form-error" hidden>That didn't go through. Please try again, or send the link on WhatsApp instead.</p>
        <form class="form" method="POST" action="/contact.php" data-lead="free-sample">
          <input type="hidden" name="form" value="sample" />
          <input type="hidden" name="via" value="email" />
          <div class="row2">
            <div class="field"><label for="fs-first">First name</label><input id="fs-first" name="first_name" autocomplete="given-name" required /></div>
            <div class="field"><label for="fs-last">Last name</label><input id="fs-last" name="last_name" autocomplete="family-name" required /></div>
          </div>
          <div class="field">
            <label for="fs-email">Email (optional)</label>
            <input id="fs-email" name="email" type="email" autocomplete="email" aria-describedby="fs-email-hint" />
            <span class="hint" id="fs-email-hint">Not needed if you send on WhatsApp. Needed if you send by email.</span>
          </div>
          <div class="field">
            <label for="fs-link">Link to 3 photos</label>
            <input id="fs-link" name="photos_link" type="url" inputmode="url" placeholder="https://drive.google.com/…" required aria-describedby="fs-link-hint" />
            <span class="hint" id="fs-link-hint">Google Drive, Dropbox or WeTransfer. RAW files give the best result.</span>
          </div>
          <div class="row2">
            <div class="field">
              <label for="fs-type">Type of shoot</label>
              <select id="fs-type" name="shoot_type">
                {site.contact.services.slice(0, 3).map((s) => <option>{s}</option>)}
                <option>Other photo work</option>
              </select>
            </div>
            <div class="field">
              <label for="fs-size">Full gallery size (roughly)</label>
              <input id="fs-size" name="gallery_size" inputmode="numeric" placeholder="e.g. 500" />
            </div>
          </div>
          <fieldset class="field">
            <legend>Style</legend>
            <div class="radios">
              <label><input type="radio" name="style" value="Match my reference" checked /> Match my reference or preset</label>
              <label><input type="radio" name="style" value="Natural and true-to-life" /> Natural and true-to-life</label>
              <label><input type="radio" name="style" value="Your choice" /> Your choice</label>
            </div>
          </fieldset>
          <div class="field">
            <label for="fs-ref">Reference edits or preset link (optional)</label>
            <input id="fs-ref" name="reference" type="url" placeholder="https://…" />
          </div>
          <div class="field">
            <label for="fs-notes">Notes (optional)</label>
            <textarea id="fs-notes" name="message" rows="4" aria-describedby="fs-notes-hint"></textarea>
            <span class="hint" id="fs-notes-hint">Deadline, anything to avoid, sneak-peek images you need first.</span>
          </div>
          <div class="hp" aria-hidden="true"><label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>
          {site.turnstileSiteKey && <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey}></div>}
          <div class="btn-row">
            <button class="btn btn--wa" type="button" data-wa-submit><BrandIcon name="whatsapp" size={20} color="currentColor" /> Send on WhatsApp</button>
            <button class="btn btn--s" type="submit" data-email-submit>Send by email instead</button>
          </div>
          <p class="small muted">WhatsApp opens with your details already filled in. Just press send. A copy also comes to me by email.</p>
          <p class="small muted">Your photos are only used to edit your sample and are deleted afterwards. See the <a href="/privacy/">privacy policy</a>.</p>
        </form>
      </div>
      <aside class="stack">
        <div class="card card--soft">
          <h2 class="h3" style="font:600 1.2rem/1.3 var(--f-body)">What happens next</h2>
          <ol class="steps" style="margin-top:1rem">
            <li><div><b>I check your photos</b><p>And reply {site.replyTime} if anything is unclear.</p></div></li>
            <li><div><b>Three edits come back</b><p>{site.freeSample.turnaround[0].toUpperCase() + site.freeSample.turnaround.slice(1)}, in your style.</p></div></li>
            <li><div><b>You decide</b><p>Order the full gallery, ask for changes, or walk away. No pressure.</p></div></li>
          </ol>
        </div>
        <div class="card">
          <h2 style="font:600 1.05rem/1.3 var(--f-body)">Prefer WhatsApp?</h2>
          <p>Send the link to <a class="link" href={waLink("Hi Harinda, here's a link to 3 photos for a free sample edit:")} data-track="whatsapp">{site.contact.whatsappDisplay}</a></p>
        </div>
        <blockquote class="card">
          <p style="font:400 1.1rem/1.45 var(--f-display);color:var(--fg)">“{quote.text}”</p>
          <p class="small muted" style="margin-top:.75rem">{quote.name} · {quote.flag} {quote.country}</p>
        </blockquote>
      </aside>
    </div>
  </section>
  <script is:inline define:vars={{ waNumber: site.contact.whatsapp }}>
    if (location.search.includes("error=1")) document.getElementById("form-error").hidden = false;

    // "Send on WhatsApp": check the form, email a copy in the background, then open
    // WhatsApp with every answer already in the message.
    const form = document.querySelector("form[data-lead='free-sample']");
    const waBtn = form?.querySelector("[data-wa-submit]");
    const emailInput = form?.querySelector("#fs-email");
    // Email is only required when the request goes by email.
    form?.querySelector("[data-email-submit]")?.addEventListener("click", () => {
      emailInput.required = true;
      form.elements.via.value = "email";
    });
    waBtn?.addEventListener("click", () => {
      emailInput.required = false;
      form.elements.via.value = "whatsapp";
      if (!form.reportValidity()) return;
      const d = new FormData(form);
      if (d.get("company")) return; // honeypot
      const v = (k) => String(d.get(k) ?? "").trim();
      const fields = [
        `Name: ${v("first_name")} ${v("last_name")}`,
        v("email") && `Email: ${v("email")}`,
        `Photos: ${v("photos_link")}`,
        `Shoot: ${v("shoot_type")}`,
        v("gallery_size") && `Full gallery: about ${v("gallery_size")} photos`,
        `Style: ${v("style")}`,
        v("reference") && `Reference: ${v("reference")}`,
        v("message") && `Notes: ${v("message")}`,
      ].filter(Boolean);
      const lines = ["Hi Harinda, I'd like a free sample edit (3 photos).", "", ...fields];
      // Email copy, so the request is on record even if the WhatsApp message isn't sent.
      try { fetch(form.action, { method: "POST", body: d, keepalive: true, mode: "no-cors" }); } catch (e) {}
      window.gtag?.("event", "generate_lead", { form: "free-sample", method: "whatsapp" });
      location.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(lines.join("\n"))}`;
    });
  </script>
</BaseLayout>
