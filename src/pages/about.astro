---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import Bits from "../components/Bits.astro";
import Cta from "../components/Cta.astro";
import site, { waLink } from "../data/site.js";
import { breadcrumb } from "../lib/schema.js";

const crumbs = [{ name: "Home", path: "/" }, { name: "About", path: "/about/" }];
const setup = [
  ["Monitor", "Factory-calibrated ASUS ProArt, Calman Verified"],
  ["Software", "Adobe Lightroom Classic, Lightroom and Photoshop"],
  ["Room", "Neutral grey, controlled light, so color is judged without a cast"],
  ["Delivery", "Google Drive, full-resolution files, no compression"],
  ["Connection", "Starlink, so large RAW uploads and downloads don't stall"],
];
---
<BaseLayout rawTitle="About Harinda Fernando — Photo Editor & Web Developer" description="Meet Harinda Fernando: a former photographer turned full-time Lightroom editor and web developer, working with photographers in the US, UK and Europe." path="/about/" jsonLd={[breadcrumb(crumbs)]}>
  <PageHero eyebrow="About" title="Hi, I'm Harinda. I'm the person who edits your photos." crumbs={crumbs} />
  <section class="sec sec--top0">
    <div class="wrap grid g2" style="align-items:start">
      <figure class="ph ph--3x2" data-parallax>
        <img src={site.aboutImage.src} width={site.aboutImage.width} height={site.aboutImage.height} alt={site.aboutImage.alt} fetchpriority="high" decoding="async" />
      </figure>
      <div class="prose">
        <p class="lede">I spent years behind the camera before moving to the other side of the workflow. Now I edit full time, from a small studio in Sri Lanka, for photographers in the US, UK, Canada, Europe and Australia.</p>
        <p>It isn't a studio floor or a queue of freelancers. The person you message is the person who edits your gallery, in Lightroom Classic and Photoshop, on a calibrated screen. I don't hand a gallery back until it looks like you edited it.</p>
        <p>AI editing tools are fast, but they apply a look. They guess white balance, smooth skin into plastic and drift across a set so the hundredth photo doesn't match the first. A person notices that the dress is white, that the bride's skin has a particular warmth, and that the light changed when the sun went behind a cloud halfway through the ceremony.</p>
        <div class="btn-row"><a class="btn btn--p" href="/free-sample/">{site.freeSample.cta}</a><a class="btn btn--s" href={waLink("Hi Harinda, I read your About page.")} data-track="whatsapp">WhatsApp me</a></div>
      </div>
    </div>
  </section>

  <section class="sec sec--alt sec--tight"><div class="wrap"><Bits kind="stats" /></div></section>

  <section class="sec">
    <div class="wrap grid g2" style="align-items:start">
      <div>
        <span class="eyebrow">The setup</span>
        <h2 class="h2" style="margin:.75rem 0 1.25rem">Where your photos get edited</h2>
        <div class="table-wrap"><table><tbody>{setup.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table></div>
      </div>
      <div>
        <span class="eyebrow">Working together</span>
        <h2 class="h2" style="margin:.75rem 0 1.25rem">Practical details</h2>
        <ul class="checks">
          <li>{site.location.note}</li>
          <li>I reply {site.replyTime}, usually much faster on WhatsApp.</li>
          <li>Direct photo orders are paid after you approve the gallery.</li>
          <li>The Fiverr profile has {site.fiverrStats.reviews}+ reviews and {site.fiverrStats.ordersPlus}+ orders.</li>
          <li>I also build websites and design polo and golf shirts, each with its own page and pricing.</li>
        </ul>
        <div class="chips" style="margin-top:1.5rem">
          {site.otherServices.map((s) => <a class="pill" href={s.href} style="text-decoration:none">{s.label} →</a>)}
        </div>
      </div>
    </div>
  </section>
  <Cta />
</BaseLayout>
