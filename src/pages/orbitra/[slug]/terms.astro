---
// /orbitra/<slug>/terms/ — terms of use. Plain-language template; have it reviewed
// before relying on it legally. App-specific points come from apps.json → termsNotes.
import OrbitraLayout from "../../../layouts/OrbitraLayout.astro";
import LegalDoc from "../../../components/orbitra/LegalDoc.astro";
import { studio, apps, appPath, rich } from "../../../lib/orbitra.js";

export function getStaticPaths() {
  return apps.map((app) => ({ params: { slug: app.slug }, props: { app } }));
}

const { app } = Astro.props;
const r = (s) => rich(s, app);

const toc = [
  ["short-version", "Short version"],
  ["agreement", "Agreeing to these terms"],
  ["using-the-app", "Using the app"],
  ["your-content", "Your content"],
  ["acceptable-use", "Acceptable use"],
  ["app-notes", `About ${app.name}`],
  ["third-parties", "Google Play and other services"],
  ["changes-to-app", "Changes to the app"],
  ["disclaimer", "No warranty"],
  ["liability", "Limitation of liability"],
  ["ending", "Ending these terms"],
  ["law", "Governing law"],
  ["changes", "Changes to these terms"],
  ["contact", "Contact"],
].map(([id, label]) => ({ id, label }));
---

<OrbitraLayout
  title={`Terms of Use — ${app.name} by Orbitra`}
  description={`The terms for using ${app.name} by Orbitra, in plain words.`}
  app={app}
  crumbs={[
    { label: "Orbitra", href: studio.basePath },
    { label: app.name, href: appPath(app.slug) },
    { label: "Terms" },
  ]}
>
  <LegalDoc title="Terms of Use" subtitle={`${app.name}, by Orbitra`} toc={toc} updated={app.lastUpdated ?? undefined}>
    <section class="o-callout" aria-labelledby="short-version">
      <h2 id="short-version" class="o-heading">Short version</h2>
      <ul>
        <li>Use {app.name} for lawful, personal or business purposes.</li>
        <li>What you create in the app is yours.</li>
        <li>We work hard to keep it accurate and working, but we can’t promise it will never fail.</li>
        <li>Questions? <Fragment set:html={r("Email {email}.")} /></li>
      </ul>
    </section>

    <h2 id="agreement">Agreeing to these terms</h2>
    <p set:html={r(`These terms are between you and **Orbitra**, the publisher of **{app}** (\`${app.package}\`). By installing or using the app you agree to them. If you don’t agree, please don’t use the app.`)} />

    <h2 id="using-the-app">Using the app</h2>
    <p>
      We give you a personal, non-exclusive, non-transferable right to use {app.name} on devices you own or control.
      The app, its design, name, icon and code belong to Orbitra and are protected by copyright and trademark law. Please
      don’t copy, resell, reverse-engineer or redistribute the app, except where the law allows it.
    </p>

    <h2 id="your-content">Your content</h2>
    <p>
      Anything you enter or create in the app stays yours. We don’t claim any rights to it. How we handle data is
      explained in the <a href={appPath(app.slug, "privacy-policy")}>privacy policy</a>.
    </p>

    <h2 id="acceptable-use">Acceptable use</h2>
    <p>Please don’t use the app to:</p>
    <ul>
      <li>break the law or anyone else’s rights, including copyright;</li>
      <li>try to break, overload or get unauthorised access to the app or the services behind it;</li>
      <li>harm, harass or mislead other people.</li>
    </ul>

    <h2 id="app-notes">About {app.name}</h2>
    <ul>{app.termsNotes.map((n) => <li set:html={r(n)} />)}</ul>

    <h2 id="third-parties">Google Play and other services</h2>
    <p>
      You download the app from Google Play, so the
      <a href="https://play.google.com/about/play-terms/" target="_blank" rel="noopener noreferrer">Google Play Terms of Service<span class="o-sr"> (opens in a new tab)</span></a>
      also apply. Links to other websites or services are provided for convenience; those services have their own
      terms and we are not responsible for them.
    </p>

    <h2 id="changes-to-app">Changes to the app</h2>
    <p>
      We may update, change or stop parts of the app at any time — for example to fix bugs, add features or meet new
      rules. If we ever stop the app completely, we will try to give notice so you can export anything you need.
    </p>

    <h2 id="disclaimer">No warranty</h2>
    <p>
      The app is provided “as is” and “as available”. As far as the law allows, we don’t promise that it will be
      error-free, always available, or right for your particular purpose.
    </p>

    <h2 id="liability">Limitation of liability</h2>
    <p>
      As far as the law allows, Orbitra is not liable for indirect or consequential loss, or for loss of data, profit
      or business, arising from your use of the app. Nothing in these terms limits liability that cannot be limited by
      law, or your rights as a consumer where you live.
    </p>

    <h2 id="ending">Ending these terms</h2>
    <p>
      You can stop using the app at any time by uninstalling it. We may stop providing the app to anyone who seriously
      breaks these terms.
    </p>

    <h2 id="law">Governing law</h2>
    <p set:html={r("These terms are governed by the laws of Sri Lanka, without affecting any consumer protection rights you have where you live.")} />

    <h2 id="changes">Changes to these terms</h2>
    <p>
      If we change these terms, we will update this page and the “Last updated” date at the top. If you keep using the
      app after a change, the new terms apply.
    </p>

    <h2 id="contact">Contact</h2>
    <p set:html={r(`Orbitra — {email}. For help with the app, see [{app} support](${appPath(app.slug, "support")}).`)} />
  </LegalDoc>
</OrbitraLayout>
