<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ProductWhite" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pw_chroma_blue</item>
        <item name="colorOnPrimary">@color/pw_studio_white</item>
        <item name="android:colorBackground">@color/pw_paper</item>
        <item name="colorSurface">@color/pw_studio_white</item>
        <item name="colorOnSurface">@color/pw_ink</item>
        <item name="android:statusBarColor">@color/pw_paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Android 12+ splash -->
    <style name="Theme.ProductWhite.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pw_chroma_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.ProductWhite</item>
    </style>
</resources>
