# Build-time settings. In production these come from GitHub repository variables
# (Settings → Secrets and variables → Actions → Variables), passed in by
# .github/workflows/deploy.yml. Leave them unset locally so localhost and preview
# builds never send analytics.
PUBLIC_GA_ID=
PUBLIC_CLARITY_ID=
PUBLIC_AHREFS_KEY=
SITE_URL=https://www.iamharinda.com
