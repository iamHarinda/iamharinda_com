# =============================================================================
#  iamharinda.com — Apache config for Hostinger Business shared hosting
#  Canonical host: https://www.iamharinda.com
# =============================================================================

Options -Indexes
DirectoryIndex index.html

# ── Force HTTPS + canonical www host ─────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Any request that is not HTTPS, or that uses the bare (non-www) host,
  # is redirected once to https://www.iamharinda.com + the same path.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^iamharinda\.com$ [NC]
  RewriteRule ^ https://www.iamharinda.com%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Custom error page ───────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json \
    application/xml application/rss+xml image/svg+xml \
    font/ttf font/otf application/vnd.ms-fontobject
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── Caching ─────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Fingerprinted build assets — safe to cache hard.
  <FilesMatch "\.(?:css|js|mjs|woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:jpg|jpeg|png|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML and text data — always revalidate so content updates show immediately.
  <FilesMatch "\.(?:html|xml|txt|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Small hardening
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── MIME types (in case the host is missing any) ────────────────────────────
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType text/plain .txt
  AddType application/json .json
</IfModule>

# ── Keep PHP source and dotfiles private ───────────────────────────────────
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<Files "contact.php">
  Require all granted
</Files>
