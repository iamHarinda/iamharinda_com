# =============================================================================
#  iamharinda.com — Apache config for Hostinger Business shared hosting
#  Canonical host: https://www.iamharinda.com
# =============================================================================

Options -Indexes
DirectoryIndex index.html

# ── Force HTTPS + canonical www host ─────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Any request that is not HTTPS, or whose host is anything other than
  # www.iamharinda.com — the bare domain, a staging/preview subdomain, a raw
  # IP — is redirected once to https://www.iamharinda.com + the same path.
  # This also folds the indexed preview copy
  # (iamharinda-com.preview-domain.com) into the live site instead of letting
  # it compete in search. If the preview is hosted somewhere this file is not
  # deployed, take it offline there or send X-Robots-Tag: noindex from it.
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.iamharinda\.com$ [NC]
  RewriteRule ^ https://www.iamharinda.com%{REQUEST_URI} [R=301,L]

  # ── Renamed pages ───────────────────────────────────────────────────────
  # apparel-pattern-tech-packs/ was reframed as fashion/print pattern design
  # (see src/pages/fashion-designing.astro) and moved here permanently.
  RewriteRule ^apparel-pattern-tech-packs/?$ /fashion-designing/ [R=301,L]
  # custom-web-development/ shortened to match the nav label.
  RewriteRule ^custom-web-development/?$ /web-development/ [R=301,L]
</IfModule>

# ── Belt and braces: any non-canonical host also answers with noindex ───────
# Runs before the redirect is followed, so crawlers that read headers on the
# 301 response still get told not to index the preview host.
<IfModule mod_setenvif.c>
  SetEnvIf Host "^(?!www\.iamharinda\.com$).*$" NON_CANONICAL_HOST
</IfModule>
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=NON_CANONICAL_HOST
</IfModule>

# ── Custom error page ───────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    text/javascript application/javascript application/json \
    application/xml application/rss+xml image/svg+xml \
    font/ttf font/otf application/vnd.ms-fontobject
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ── Caching ─────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Fingerprinted build assets — safe to cache hard.
  <FilesMatch "\.(?:css|js|mjs|woff2|woff|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:jpg|jpeg|png|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML and text data — always revalidate so content updates show immediately.
  <FilesMatch "\.(?:html|xml|txt|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Small hardening
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ── MIME types (in case the host is missing any) ────────────────────────────
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType text/plain .txt
  AddType application/json .json
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

# ── Keep PHP source and dotfiles private ───────────────────────────────────
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
<Files "contact.php">
  Require all granted
</Files>
