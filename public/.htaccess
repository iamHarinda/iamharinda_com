# =============================================================================
#  iamharinda.com — Apache / LiteSpeed config for Hostinger (behind Cloudflare)
#  Canonical host: https://www.iamharinda.com
# =============================================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # One hop to https://www. for any other scheme/host (bare domain, preview hosts, raw IP).
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\.iamharinda\.com$ [NC]
  RewriteRule ^ https://www.iamharinda.com%{REQUEST_URI} [R=301,L]

  # ── Renamed / moved pages (single hop each) ────────────────────────────
  RewriteRule ^wedding-photo-editing/?$ /photo-editing/wedding/ [R=301,L]
  RewriteRule ^custom-web-development/?$ /web-development/ [R=301,L]
  RewriteRule ^apparel-pattern-tech-packs/?$ /fashion-designing/ [R=301,L]
  RewriteRule ^portrait-editing/?$ /photo-editing/portrait-headshot/ [R=301,L]
  RewriteRule ^product-photo-editing/?$ /photo-editing/product-food/ [R=301,L]
  RewriteRule ^portfolio/?$ /work/ [R=301,L]
  RewriteRule ^sample/?$ /free-sample/ [R=301,L]
</IfModule>

# Non-canonical hosts also answer noindex (folds old preview copies out of search).
<IfModule mod_setenvif.c>
  SetEnvIf Host "^(?!www\.iamharinda\.com$).*$" NON_CANONICAL_HOST
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/rss+xml image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow" env=NON_CANONICAL_HOST

  # Fingerprinted build assets and fonts — cache for a year.
  <FilesMatch "\.(?:css|js|mjs|woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(?:jpg|jpeg|png|webp|avif|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # HTML, feeds, sitemaps — always revalidate.
  <FilesMatch "\.(?:html|xml|txt|json|webmanifest)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # ── Security headers ────────────────────────────────────────────────────
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # Starts in Report-Only so nothing breaks; switch the header name to
  # Content-Security-Policy after a week with no violations in the console.
  # fonts.googleapis.com / fonts.gstatic.com: the /orbitra/ pages load their fonts from Google Fonts.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://*.clarity.ms https://challenges.cloudflare.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com https://*.clarity.ms; img-src 'self' data: https://res.cloudinary.com https://*.google-analytics.com https://*.googletagmanager.com https://*.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'self'; frame-ancestors 'self'; object-src 'none'; upgrade-insecure-requests"
  Header unset X-Powered-By
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/avif .avif
  AddType application/manifest+json .webmanifest
  AddType application/rss+xml .xml
</IfModule>

# Keep dotfiles (deploy state, etc.) private.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>
